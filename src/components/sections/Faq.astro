---
/**
 * FAQ (Figma: кадр «2») — аккордеон на <details>, открыт один вопрос за раз, высота анимируется
 * (scripts/ui/accordion.ts). Плюс складывается в минус и светлеет. Без JS работает как обычный нативный аккордеон.
 * Вопросы — из content.ts: в макете пока текст про премию.
 */
import { faq } from '../../data/content';
import { withBase } from '../../lib/paths';
---

<section class="faq" id="faq" style={`--faq-line:url(${withBase('/media/footer/dash.svg')})`}>
  <h2 class="faq__title" data-split>{faq.title}</h2>
  <div class="faq__list" data-accordion="single" data-stagger>
    {
      faq.items.map((item) => (
        <details class="faq__item">
          <summary class="faq__q">
            <span class="faq__text">{item.q}</span>
            <span class="faq__icon" aria-hidden="true" />
          </summary>
          <div class="faq__a">
            <p class:list={{ fish: item.draft }}>{item.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* сетка макета: заголовок по центру x=305, вопросы от x=538 шириной 635 */
  .faq {
    position: relative;
    padding: 114px 0 106px;
  }
  .faq__title {
    position: absolute;
    left: calc(50% - 468px);
    top: 114px;
    font-size: 65px;
    font-weight: 300;
    line-height: 55px;
    letter-spacing: -3.25px;
    white-space: nowrap;
    color: #fff;
  }
  .faq__list {
    width: 635px;
    margin-left: calc(50% - 182px);
  }
  .faq__item {
    background: var(--faq-line) 0 100% / 635px 1px no-repeat;
  }
  .faq__q {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    min-height: 114px;
    padding: 27px 0;
    list-style: none;
    cursor: pointer;
  }
  .faq__item:first-child .faq__q {
    min-height: 87px;
    padding-top: 0;
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__text {
    width: 467px;
    color: #fff;
    font-size: 20px;
    line-height: 30px;
    transition: color 0.3s;
  }
  .faq__q:hover .faq__text {
    color: var(--c-accent);
  }
  /* иконка 30×30: линии тонкие, как в макете; вертикальная поворачивается и совпадает с горизонтальной */
  .faq__icon {
    position: relative;
    flex: none;
    width: 30px;
    height: 30px;
    margin-right: 0;
    color: #fce39c;
    transition: color 0.4s, transform 0.5s var(--ease-out);
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 0;
    top: 14px;
    width: 30px;
    height: 2px;
    background: currentColor;
    transition: transform 0.5s var(--ease-out);
  }
  .faq__icon::after {
    transform: rotate(90deg);
  }
  .faq__q:hover .faq__icon {
    transform: rotate(90deg);
  }
  .faq__item[open]:not(.is-closing) .faq__icon {
    color: #fff;
    transform: none;
  }
  .faq__item[open]:not(.is-closing) .faq__icon::after {
    transform: rotate(0deg);
  }
  .faq__a {
    overflow: hidden;
  }
  .faq__a p {
    width: 540px;
    padding-bottom: 42px;
    color: #fff;
    font-size: 20px;
    line-height: 26px;
  }

  /* мобильный (Figma: «11 · FAQ») */
  @media (max-aspect-ratio: 1/1) {
    .faq {
      padding: 78px 0 70px;
    }
    .faq__title {
      left: 16px;
      top: 30px;
      font-size: 38px;
      line-height: 36px;
      letter-spacing: -1.9px;
    }
    .faq__list {
      width: calc(100% - 32px);
      margin-left: 16px;
    }
    .faq__item {
      background-size: 100% 1px;
    }
    .faq__q,
    .faq__item:first-child .faq__q {
      gap: 16px;
      min-height: 0;
      padding: 22px 0;
    }
    .faq__item[open]:not(.is-closing) .faq__q {
      padding-bottom: 14px;
    }
    .faq__text {
      width: auto;
      flex: 1;
      font-size: 18px;
      line-height: 26px;
    }
    .faq__icon {
      width: 24px;
      height: 24px;
    }
    .faq__icon::before,
    .faq__icon::after {
      top: 11px;
      width: 24px;
    }
    .faq__a p {
      width: auto;
      max-width: 320px;
      padding-bottom: 26px;
      font-size: 16px;
      line-height: 23px;
    }
  }
</style>
