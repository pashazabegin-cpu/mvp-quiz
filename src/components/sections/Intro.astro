---
/**
 * 02 · «Что мы придумали?» (Figma: кадр «2» 1440 и «2 · mobile» 375).
 * Десктоп: экран закреплён, текст закрашивается по словам, теги/снежинки/фото проезжают снизу вверх
 * на разной глубине — в середине пути стоят ровно как в макете (кадр «2»).
 * Мобильный: без закрепления — обычный экран 375×829 (кадр макета 743 + 86: головы опущены под текст,
 * отдельно от него), всё стоит на местах, текст проявляется по абзацам.
 * Логика — scripts/sections/intro.ts
 */
import Anno from '../ui/Anno.astro';
import { intro } from '../../data/content';
import { withBase } from '../../lib/paths';
import { paragraph } from '../../lib/text';

// позиция на сцене: десктоп — доля ширины кадра 1440 и px кадра 900, мобильный — доля 375 и px кадра 829
const floatStyle = (f: (typeof intro.floats)[number]) =>
  [
    `--x:${((f.x / 1440) * 100).toFixed(3)}%;--y:${f.y}px`,
    'w' in f && f.w ? `--w:${f.w}px;--h:${f.h}px` : '',
    'm' in f && f.m ? `--mx:${((f.m.x / 375) * 100).toFixed(3)}%;--my:${f.m.y}px;--mw:${f.m.w}px${'h' in f.m ? `;--mh:${f.m.h}px` : ''}` : '',
  ]
    .filter(Boolean)
    .join(';');
---

<section class="intro stage" id="about" data-intro-section data-story-row style="--story-row: 0px">
  <div class="stage__ui">
    <h2 class="intro__title" data-split>
      {intro.title[0]}<br /><span class="accent">{intro.title[1]}</span>
    </h2>
    <div class="intro__lead" data-intro-lead>
      {
        intro.paragraphs.map((p, i) => (
          <p>
            {paragraph(p, intro.paragraphsMobile[i]).map((t, j, all) => (
              <>
                {t.word}
                {j < all.length - 1 && ' '}
                {t.d && <br class="br-d" />}
                {t.m && <br class="br-m" />}
              </>
            ))}
          </p>
        ))
      }
    </div>
    <div class="intro__floats" aria-hidden="true">
      {
        intro.floats.map((f) => (
          <div
            class:list={[
              'intro__float',
              `intro__float--${f.kind}`,
              'back' in f && f.back && 'intro__float--back',
              !('m' in f) && 'intro__float--no-m',
              'mobileOnly' in f && f.mobileOnly && 'intro__float--m-only',
            ]}
            data-float
            data-z={f.z}
            style={floatStyle(f)}
          >
            {f.kind === 'tag' ? (
              <span class="pill pill--sq" style={`--pill:var(${f.color === 'accent' ? '--c-accent' : '--c-accent-2'})`}>
                {f.text}
              </span>
            ) : (
              <img src={withBase(f.src!)} width={f.w} height={f.h} alt="" loading="lazy" decoding="async" />
            )}
          </div>
        ))
      }
    </div>
  </div>
  <Anno kind="screen">02 · Что мы придумали?</Anno>
</section>

<style>
  .intro {
    color: var(--c-text);
  }
  /* 65/65, верх — 102 в кадре «2» (кадр экрана начинается с 60) */
  .intro__title {
    left: 50%;
    top: calc(50% - 450px + 42px);
    width: 380px;
    margin-left: -190px;
    font-size: 65px;
    font-weight: 300;
    line-height: 65px;
    letter-spacing: -3.25px;
    text-align: center;
    white-space: nowrap;
  }
  .accent {
    color: var(--c-accent);
  }
  .intro__lead {
    left: 50%;
    top: calc(50% - 450px + 349px);
    width: 750px;
    margin-left: -375px;
    font-size: 26px;
    line-height: 1.45;
    text-align: center;
  }
  .intro__lead p + p {
    margin-top: 1.45em;
  }
  /* слой проезжающих элементов: по вертикали — кадр 900, по горизонтали растянут на весь экран
     (x — доля ширины кадра 1440), чтобы крайние снежинки оставались у краёв на широких экранах */
  .intro__floats {
    left: 0;
    top: calc(50% - 450px);
    width: 100%;
    height: 900px;
    pointer-events: none;
  }
  .intro__float {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w, auto);
    height: var(--h, auto);
    will-change: transform;
  }
  /* дальний план — за текстом */
  .intro__float--back {
    z-index: -1;
  }
  /* фото вписаны в рамку 179×201 целиком, как в макете (пропорции у снимков разные) */
  .intro__float img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* элемент только для мобильного кадра */
  .intro__float--m-only {
    display: none;
  }

  /* мобильный (Figma: «2 · mobile» → «02 · Что мы придумали?»): обычный экран 375×829 без закрепления.
     Теги убраны, головы внизу — отдельно, на 64 px ниже текста; снежинки на своих местах, x — доля ширины кадра */
  @media (max-aspect-ratio: 1/1) {
    .intro {
      height: calc(829px * var(--ui-s));
      min-height: 0;
    }
    .intro > .stage__ui {
      height: 829px;
    }
    .intro__title {
      top: calc(50% - 414.5px + 68px);
      width: 300px;
      margin-left: -150px;
      font-size: 38px;
      line-height: 36px;
      letter-spacing: -1.9px;
    }
    .intro__lead {
      top: calc(50% - 414.5px + 202px);
      width: 343px;
      margin-left: -171.5px;
      font-size: 18px;
    }
    .intro__lead p + p {
      margin-top: 26px;
    }
    .intro__floats {
      top: calc(50% - 414.5px);
      height: 829px;
    }
    /* на мобильном элементы не двигаются — отдельные слои под анимацию им не нужны */
    .intro__float {
      left: var(--mx);
      top: var(--my);
      width: var(--mw);
      height: var(--mh, auto);
      will-change: auto;
    }
    .intro__float--snow img {
      height: auto;
    }
    /* головы — над соседними снежинками */
    .intro__float--photo {
      z-index: 2;
    }
    .intro__float--no-m {
      display: none;
    }
    .intro__float--m-only {
      display: block;
    }
  }
</style>
