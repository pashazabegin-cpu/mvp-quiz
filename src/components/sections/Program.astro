---
/**
 * 03 · «Что будет?» — Кибермейджор / MVP Talks / Спортивный квиз
 * (Figma: кадр «2» — первый пункт, кадры «MVP Talks» и «Спортивный квиз» — следующие состояния).
 * Экран закреплён на три шага скролла. Заголовки пунктов всегда на экране: активный — белый,
 * соседний — 20%, дальний — 5%; на десктопе список сдвигается на шаг, активный встаёт на одну линию.
 * Иконка — WebGL-переход (canvas) на десктопе, на мобильном — простая смена картинок.
 * Мобильный: закрепление — CSS sticky внутри дорожки .program-track, пункты сменяются шагами
 * (яркость, картинка и описание плавно сменяются, без привязки к каждому пикселю скролла).
 * Логика — scripts/sections/program.ts, scripts/effects/icon-morph.ts
 */
import Anno from '../ui/Anno.astro';
import { program } from '../../data/content';
import { withBase } from '../../lib/paths';
const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<!-- дорожка закрепления: на мобильном экран «прилипает» к верху (CSS sticky) на её высоту,
     на десктопе её роль у ScrollTrigger pin, а сама она — обычная обёртка -->
<div class="program-track" data-program-track>
<section class="program stage" id="program" data-program>
  <div class="stage__ui">
    <h2 class="program__title" data-split>{program.title[0]} <span class="accent">{program.title[1]}</span></h2>

    <ol class="program__list" data-program-list>
      {
        program.items.map((it) => (
          <li class="program__item" data-program-item>
            <button class="program__btn" type="button">{it.title}</button>
          </li>
        ))
      }
    </ol>

    <div class="program__icon" data-tilt="10">
      <div class="program__float" data-program-float>
        <canvas class="program__canvas" data-icon-morph aria-hidden="true"></canvas>
        {
          program.items.map((it, i) => (
            <img
              class="program__img"
              src={withBase(it.icon)}
              width="441"
              height="351"
              alt={it.title}
              style={i === 0 ? undefined : 'opacity:0'}
              data-program-img
            />
          ))
        }
      </div>
    </div>

    {
      program.items.map((it, i) => (
        <div class="program__info" data-program-info>
          <p class="program__num" data-step-lines>{pad(i)}</p>
          <p class="program__lead" data-step-lines>
            {it.lead.split('\n').map((line, j) => (
              <>
                {j > 0 && <>{' '}<br class="br-d" /></>}
                {line}
              </>
            ))}
          </p>
        </div>
      ))
    }
  </div>
  <Anno kind="screen">03 · Что будет?</Anno>
</section>
</div>

<style>
  .program {
    color: var(--c-text);
  }
  .accent {
    color: var(--c-accent);
  }
  /* «Что будет?» 65/55 по центру, 45 px от верха кадра */
  .program__title {
    left: 50%;
    top: calc(50% - 450px + 45px);
    width: 380px;
    margin-left: -190px;
    font-size: 65px;
    font-weight: 300;
    line-height: 55px;
    letter-spacing: -3.25px;
    text-align: center;
    white-space: nowrap;
  }
  /* активный пункт стоит на 338 (кадры «MVP Talks», «Спортивный квиз»), шаг — 91 */
  .program__list {
    --step: 91px;
    left: calc(60px + var(--col));
    top: calc(50% - 450px + 338px);
    width: 380px;
    will-change: transform;
  }
  .program__item {
    height: 45px;
    margin-bottom: calc(var(--step) - 45px);
    font-size: 45px;
    font-weight: 300;
    line-height: 45px;
    letter-spacing: -2.25px;
    white-space: nowrap;
  }
  /* пункт — кнопка: клик докручивает экран до него (program.ts); выглядит как текст */
  .program__btn {
    display: block;
    width: 100%;
    letter-spacing: inherit;
    line-height: inherit;
    text-align: inherit;
    white-space: nowrap;
  }
  .program__item:not(.is-active) .program__btn {
    cursor: pointer;
  }
  /* под курсором неактивный пункт проявляется сильнее (поверх яркости, которую ставит скрипт) */
  @media (hover: hover) {
    .program__item:not(.is-active):hover {
      opacity: 0.6 !important;
    }
  }
  /* до запуска скрипта — как в макете: следующий пункт 20%, дальше 5% */
  .program__item:nth-child(2) {
    opacity: 0.2;
  }
  .program__item:nth-child(n + 3) {
    opacity: 0.05;
  }
  /* иконка 441×351: центр — 6-я колонка (535 при 1440) */
  .program__icon {
    left: calc(60px + var(--col) * 5);
    top: calc(50% - 450px + 263px);
    width: 441px;
    height: 351px;
  }
  .program__float {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .program__canvas,
  .program__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .program__canvas {
    display: none;
  }
  .program.is-gl .program__canvas {
    display: block;
  }
  .program.is-gl .program__img {
    visibility: hidden;
  }
  /* до запуска скрипта видно только первое описание */
  .program:not(.is-ready) .program__info ~ .program__info {
    visibility: hidden;
  }
  .program__info {
    left: calc(60px + var(--col) * 10);
    top: calc(50% - 450px + 274px);
    width: 282px;
    font-weight: 300;
  }
  .program__num {
    font-size: 20px;
    line-height: 20px;
  }
  .program__lead {
    margin-top: 90px;
    font-size: 22px;
    line-height: 32px;
  }

  /* мобильный (Figma: «2 · mobile» → «03 · Программа»): всё по центру, блок от заголовка
     до конца описания (613 px) — по центру экрана; список не двигается, меняется только яркость */
  @media (max-aspect-ratio: 1/1) {
    /* закрепление без скрипта: экран «прилипает» к верху, пока проезжает дорожка (экран + 3 × 70% высоты).
       Его ведёт сам браузер — без рывков в начале и в конце, как у закрепления из JS на телефонах */
    .program-track {
      height: max(310vh, calc(520px + 210vh));
      height: max(310svh, calc(520px + 210svh));
    }
    .program {
      position: sticky;
      top: 0;
    }
    .program__title {
      top: calc(50% - 306.6px);
      width: 300px;
      margin-left: -150px;
      font-size: 38px;
      line-height: 36px;
      letter-spacing: -1.9px;
    }
    .program__list {
      --step: 36px;
      left: 16px;
      top: calc(50% - 306.6px + 96.2px);
      width: calc(var(--ui-w) - 32px);
      text-align: center;
      will-change: auto;
    }
    /* шаг пунктов 36, как в макете (139 → 175 → 211): отступ считаем от мобильной высоты 32,
       а не от десктопной 45 — иначе пункты наезжали друг на друга с шагом 23 */
    .program__item {
      height: 32px;
      margin-bottom: calc(var(--step) - 32px);
      font-size: 23px;
      line-height: 32px;
      letter-spacing: -1.15px;
      transition: opacity 0.4s ease;
    }
    /* пункты сменяются шагами (program.ts): яркость и картинка доходят плавно */
    .program__img {
      transition: opacity 0.5s ease;
    }
    .program__icon {
      left: 50%;
      top: calc(50% - 306.6px + 244.2px);
      width: 233px;
      height: 186px;
      margin-left: -116.5px;
    }
    .program__info {
      left: 50%;
      top: calc(50% - 306.6px + 472.2px);
      width: 343px;
      margin-left: -171.5px;
      text-align: center;
    }
    /* в макете строка 20 при кегле 30 — цифры не помещались бы в строку, поэтому строка 30 и сдвиг на 5 вверх.
       Строки здесь не режутся на маски (описание просто сменяется), так что номер встаёт на 515, текст — на 560 */
    .program__num {
      margin-top: -5px;
      font-size: 30px;
      line-height: 30px;
    }
    .program__lead {
      margin-top: 20px;
      font-size: 22px;
      line-height: 32px;
    }
  }
</style>
