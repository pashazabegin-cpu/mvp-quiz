---
/**
 * «Локация» (Figma: кадр «2»): адрес, карта во всю ширину, фото площадки на разной глубине.
 * Карта — Яндекс Карты в стиле из data/map-style.json, адрес стоит по центру, карту можно таскать и вращать
 * правой кнопкой (scripts/sections/location.ts). Пока нет ключа API, показывается картинка из макета.
 * Прокрутка колесом над картой листает страницу, а не масштабирует карту.
 * .map__inner компенсирует масштаб кадра: API карт считает курсор в экранных px, и так карта остаётся чёткой.
 * Параллакс фото — как у фото в «Что мы придумали?», с привязкой к пикселям экрана (scripts/sections/finale.ts).
 * Мобильный (Figma: «10 · Локация»): всё стоит на месте, карта не забирает палец — скролл важнее, для маршрута есть ссылка.
 */
import { event, location, ticket } from '../../data/content';
import { withBase } from '../../lib/paths';
---

<section class="location" id="location">
  <h2 class="location__title" data-split>{location.title}</h2>
  <p class="location__venue" data-lines>{event.venue}</p>
  <p class="location__address" data-lines>{event.address}</p>

  <div
    class="map"
    data-map
    data-map-key={location.mapApiKey || undefined}
    data-map-center={location.coords.join(',')}
    data-map-zoom={location.zoom}
  >
    <div class="map__inner">
      <img class="map__poster" src={withBase(location.poster)} alt={`Карта: ${event.address}`} loading="lazy" decoding="async" />
      <div class="map__canvas" data-map-canvas></div>
      <span class="map__pin" data-map-pin aria-hidden="true">
        <span class="map__pin-ring"></span>
        <span class="map__pin-body"><img src={withBase(ticket.mark)} width="36" height="35" alt="" /></span>
      </span>
    </div>
  </div>

  {
    location.photos.map((photo) => (
      <img
        class:list={['location__photo', `location__photo--${photo.side}`]}
        data-depth={photo.depth}
        src={withBase(photo.src)}
        width="1024"
        height="683"
        alt="Площадка Avulus Cyber Space"
        loading="lazy"
      />
    ))
  }

  <a class="location__link" href={event.mapUrl} target="_blank" rel="noopener">
    <span>{location.mapLabel}</span>
    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
      <path d="M2 12 12 2M4 2h8v8" fill="none" stroke="#fce39c" stroke-width="1.1" stroke-linecap="square"></path>
    </svg>
  </a>
</section>

<style>
  .location {
    position: relative;
    height: 1180px;
    color: #fff;
    text-align: center;
  }
  .location__title {
    position: absolute;
    left: 0;
    top: 75px;
    width: 100%;
    font-size: 65px;
    font-weight: 300;
    line-height: 55px;
    letter-spacing: -3.25px;
  }
  .location__venue {
    position: absolute;
    left: 0;
    top: 284px;
    width: 100%;
    color: #f5f7fa;
    font-size: 45px;
    font-weight: 300;
    line-height: 36.11px;
    letter-spacing: 6.75px;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .location__address {
    position: absolute;
    left: 0;
    top: 352px;
    width: 100%;
    font-size: 20px;
    line-height: 26px;
  }

  .map {
    position: absolute;
    left: 0;
    top: 476px;
    width: 100%;
    height: 446px;
    overflow: hidden;
    background: #243e65;
  }
  .map__inner {
    position: relative;
    width: calc(100% * var(--ui-s));
    height: calc(100% * var(--ui-s));
    transform: scale(calc(1 / var(--ui-s)));
    transform-origin: 0 0;
  }
  .map__canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  /* картинка из макета: тот же кадр по высоте */
  .map__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 78%;
    transition: opacity 0.8s ease;
  }
  :global(.map.is-live) .map__canvas {
    opacity: 1;
  }
  :global(.map.is-live) .map__poster {
    opacity: 0;
    pointer-events: none;
  }

  /* геометка: острие — в точке адреса. На картинке стоит по центру, на живой карте её двигает YMapMarker */
  .map__pin {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    display: block;
    width: 62px;
    height: 72px;
    margin-left: -31px;
    margin-top: -72px;
    pointer-events: none;
  }
  :global(.map.is-live) .map__pin {
    left: 0;
    top: 0;
  }
  .map__pin-body {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 62px;
    height: 62px;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 14px 34px rgb(1 16 48 / 0.55);
  }
  .map__pin-body::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -7px;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    border-radius: 0 0 5px 0;
    background: #fff;
    transform: rotate(45deg);
    z-index: -1;
  }
  .map__pin-ring {
    position: absolute;
    left: 50%;
    bottom: -14px;
    width: 28px;
    height: 28px;
    margin-left: -14px;
    border: 2px solid var(--c-accent);
    border-radius: 50%;
    animation: pin-ping 2.4s var(--ease-out) infinite;
  }
  @keyframes pin-ping {
    from {
      transform: scale(0.3);
      opacity: 1;
    }
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  /*
   * Фото — одна картинка со скруглением, без обёртки с overflow: hidden: движется один слой без маски обрезки.
   * Стоят от краёв экрана, как в макете.
   */
  .location__photo {
    position: absolute;
    display: block;
    max-width: none;
    border-radius: 20px;
    object-fit: cover;
    object-position: bottom;
    pointer-events: none;
    will-change: transform;
  }
  .location__photo--left {
    left: 60px;
    top: 341px;
    width: 325px;
    height: 241px;
  }
  .location__photo--right {
    right: 93px;
    top: 819px;
    width: 379px;
    height: 205px;
  }

  .location__link {
    position: absolute;
    left: 50%;
    top: 1029px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 20px;
    line-height: 26px;
    white-space: nowrap;
    transform: translateX(-50%);
  }
  .location__link span {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.5s var(--ease-out);
  }
  .location__link:hover span {
    background-size: 100% 1px;
  }
  .location__link svg {
    flex: none;
    transition: transform 0.4s var(--ease-out);
  }
  .location__link:hover svg {
    transform: translate(2px, -2px);
  }

  @media (max-aspect-ratio: 1/1) {
    .location {
      height: 720px;
    }
    .location__title {
      top: 30px;
      font-size: 38px;
      line-height: 36px;
      letter-spacing: -1.9px;
    }
    .location__venue {
      top: 104px;
      font-size: 24px;
      line-height: 30px;
      letter-spacing: 3.6px;
    }
    .location__address {
      left: 50%;
      top: 146px;
      width: 300px;
      margin-left: -150px;
      font-size: 16px;
      line-height: 22px;
    }
    .map {
      top: 250px;
      height: 300px;
    }
    .map__poster {
      object-position: 50% 50%;
    }
    .map__pin {
      width: 52px;
      height: 60px;
      margin-left: -26px;
      margin-top: -60px;
    }
    .map__pin-body {
      width: 52px;
      height: 52px;
      border-radius: 18px;
    }
    .map__pin-body img {
      width: 30px;
      height: auto;
    }
    .map__pin-body::after {
      bottom: -5px;
      width: 14px;
      height: 14px;
      margin-left: -7px;
      border-radius: 0 0 4px 0;
    }
    .location__photo {
      border-radius: 24px;
      will-change: auto;
    }
    .location__photo--left {
      left: -36px;
      top: 196px;
      width: 196px;
      height: 118px;
    }
    .location__photo--right {
      right: -37px;
      top: 508px;
      width: 226px;
      height: 118px;
    }
    .location__link {
      top: 652px;
      gap: 10px;
      font-size: 18px;
    }
  }
</style>
