---
import { contacts } from '../../data/content';
---

<ul class="socials">
  {
    contacts.socials.map((s) => (
      <li>
        <a class="socials__link" href={s.url} target="_blank" rel="noopener" aria-label={s.label} data-magnetic>
          {s.id.toUpperCase()}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .socials {
    display: flex;
    gap: 8px;
  }
  .socials__link {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--c-line-strong);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 11px;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }
  .socials__link:hover {
    background: var(--c-text);
    border-color: var(--c-text);
    color: var(--c-bg);
  }
</style>
