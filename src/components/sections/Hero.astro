---
/**
 * 01 · Первый экран — по слайду «Квизмас» с mvpa.ru (Figma: кадр «main» 1440×900).
 * Прелоадер → видео приближается с 1.22 → тексты появляются как на MVP (data-anim: tag | lines | parts | btn).
 * Логика — scripts/sections/hero.ts, scripts/animations/mvp-reveal.ts, scripts/ui/preloader.ts
 */
import Anno from '../ui/Anno.astro';
import Button from '../ui/Button.astro';
import { contacts, event, hero } from '../../data/content';
import { withBase } from '../../lib/paths';
const tg = contacts.socials.find((s) => s.id === 'tg');
const vk = contacts.socials.find((s) => s.id === 'vk');
---

<section class="hero stage" id="top" data-hero>
  <div class="hero__zoom" data-hero-zoom>
    <div class="hero__canvas">
      <!-- видео 1600×900 от левого края кадра 1440, как в макете (слой «studio-light-shift») -->
      <div class="hero__video" data-depth="0.25">
        <video
          src={withBase(hero.video)}
          poster={withBase(hero.poster)}
          muted
          loop
          autoplay
          playsinline
          preload="auto"
          data-hero-video
          aria-hidden="true"></video>
      </div>
    </div>
  </div>
  <i class="hero__shade-mob" aria-hidden="true"></i>
  <!-- переход в чёрный следующего экрана: проявляется по мере скролла (scripts/sections/hero.ts) -->
  <i class="hero__fade" data-hero-fade aria-hidden="true"></i>

  <div class="stage__ui hero__ui" data-hero-ui>
    <!-- мобильный: меню бургером (ui/MobileMenu.astro), партнёры уходят в блок под первым экраном -->
    <button class="hc-menu" type="button" data-menu-open aria-controls="mobile-menu" aria-expanded="false" data-intro>
      <span class="hc-menu__lines" aria-hidden="true"></span>
      <span class="hc-menu__label">Меню</span>
    </button>
    {
      hero.partners.map((p) => (
        <div class="hc-partner" style={`--x:${p.x}`} data-intro>
          <span class="hp-logo">
            <img src={withBase(p.logo)} width={p.w} height={p.h} style={`--w:${p.w}px;--h:${p.h}px`} alt={p.name} />
          </span>
          <span class="hp-caption">{hero.partnerCaption}</span>
        </div>
      ))
    }
    <a class="hc-contact" href={contacts.contactUrl} target="_blank" rel="noopener" data-intro>
      <span>Связаться с нами</span>
      <img class="hc-contact__arrow" src={withBase('/media/hero/arrow.svg')} width="14.84" height="13.55" alt="" />
    </a>
    <a class="hc-social hc-social--tg" href={tg?.url} target="_blank" rel="noopener" aria-label="Telegram" data-intro>
      <span class="hc-social__icon" style={`--icon:url(${withBase('/media/hero/telegram.svg')})`} aria-hidden="true"></span>
    </a>
    <a class="hc-social hc-social--vk" href={vk?.url} target="_blank" rel="noopener" aria-label="ВКонтакте" data-intro>
      <span class="hc-social__icon" style={`--icon:url(${withBase('/media/hero/vk.svg')})`} aria-hidden="true"></span>
    </a>

    <p class="hero-tag" data-anim="tag"><span class="sq40">{hero.date}</span></p>
    <p class="hero-venue" data-anim="lines">{hero.venue}</p>
    <p class="hero-address" data-anim="lines">{hero.address}</p>
    <h1 class="hero-logo" data-anim="parts">
      <img src={withBase(hero.logo)} width="534" height="75.37" alt="MVP Квизмас" />
    </h1>
    <p class="hero-lead" data-anim="lines">{hero.lead}</p>
    <Button href={event.ticketAnchor} anim="btn" class="hero-btn">{hero.cta}</Button>
  </div>

  <Anno kind="screen">01 · Первый экран</Anno>
</section>

<!-- мобильный: партнёры сеткой 2×2 сразу под первым экраном (Figma: «main · mobile», y 833–1002) -->
<div class="hero-partners">
  <ul class="hero-partners__ui">
    {
      hero.partners.map((p) => (
        <li>
          <span class="hp-logo">
            <img src={withBase(p.logo)} width={p.w} height={p.h} style={`--w:${p.w}px;--h:${p.h}px`} alt={p.name} />
          </span>
          <span class="hp-caption">{hero.partnerCaption}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .hero {
    background: #00010b;
    color: #fff;
    isolation: isolate;
  }
  .hero__zoom {
    position: absolute;
    inset: 0;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  /* фон — холст 1600×900 (кадр 1440 + по 80 запаса), «cover» */
  .hero__canvas {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1600px;
    height: 900px;
    transform: translate(-50%, -50%) scale(var(--hero-cover));
  }
  .hero__video {
    position: absolute;
    left: 80px;
    top: 0;
    width: 1600px;
    height: 900px;
    will-change: transform;
    /* постер (ставит hero.ts), пока вместо запрещённого видео грузится ролик-картинка */
    background: 50% 50% / cover no-repeat;
  }
  /* :global — картинку-ролик (Safari в энергосбережении) создаёт скрипт, у неё нет scoped-атрибута */
  .hero__video video,
  .hero__video :global(.hero__video-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
  }
  /* фон, а не плеер: нажать на видео нельзя, системная кнопка запуска Safari не показывается */
  .hero__video video {
    pointer-events: none;
  }
  .hero__video video::-webkit-media-controls-start-playback-button {
    display: none !important;
    -webkit-appearance: none;
  }
  .hero__shade-mob {
    display: none;
  }
  .hero__fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 60%;
    background: linear-gradient(to bottom, rgb(0 0 2 / 0), rgb(0 0 2 / 0.75) 55%, var(--c-bg));
    pointer-events: none;
  }
  /* на открытом первом экране видео целиком, переход появляется при скролле */
  :global(.js-motion) .hero__fade {
    opacity: 0;
  }

  .hero__ui {
    z-index: 2;
    pointer-events: none;
  }
  /* :global — кнопка отдельный компонент, scoped-селектор её не видит */
  .hero__ui :global(a) {
    pointer-events: auto;
  }

  /* ── шапка: четыре партнёра слева, «Связаться с нами» и соцсети справа (Figma: main) ── */
  .hc-menu,
  .hero-partners {
    display: none;
  }
  /* партнёр: логотипы стоят низом на одной линии (y 111), подписи — на 126; центр — по колонкам сетки (--x) */
  .hc-partner {
    left: calc(60px + var(--col) * var(--x) - 70px);
    top: 74.76px;
    width: 140px;
  }
  /* общий вид логотипа с подписью — и в шапке, и в мобильной сетке (там всё крупнее в --k раз) */
  .hp-logo {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: calc(36.24px * var(--k, 1));
  }
  .hp-logo img {
    display: block;
    width: calc(var(--w) * var(--k, 1));
    height: calc(var(--h) * var(--k, 1));
    max-width: none;
  }
  .hp-caption {
    display: block;
    margin-top: calc(15px * var(--k, 1));
    color: rgb(255 255 255 / 0.6);
    font-size: calc(8px * var(--k, 1));
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: calc(1.2px * var(--k, 1));
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .hc-contact {
    right: calc(60px + var(--col) * 2 + 1px);
    top: 89px;
    display: flex;
    align-items: center;
    gap: 7px;
    height: 18.45px;
    font-size: 14px;
    line-height: 1.2;
    white-space: nowrap;
  }
  .hc-contact span {
    position: relative;
    top: 1.2px;
    transition: color 0.3s;
  }
  .hc-contact span::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s var(--ease-out);
  }
  /* стрелка золотая всегда, как в макете (media/hero/arrow.svg — #fce39c) */
  .hc-contact__arrow {
    width: 14.84px;
    height: 13.55px;
    transform: rotate(-45deg);
    transition: transform 0.5s var(--ease-out);
  }
  .hc-social {
    top: 88px;
    width: 20px;
    height: 20px;
  }
  /* иконка — маска по белой фигуре со знаком-прорезью: при наведении перекрашивается в золотой */
  .hc-social__icon {
    display: block;
    width: 20px;
    height: 20px;
    background-color: #fff;
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
    transition:
      transform 0.4s var(--ease-out),
      background-color 0.3s;
  }
  /* наведение — золотой, как у кнопки (цвет действия); только там, где есть курсор */
  @media (hover: hover) {
    .hc-contact:hover span {
      color: var(--c-gold);
    }
    .hc-contact:hover span::after {
      transform: scaleX(1);
      transform-origin: left;
    }
    .hc-contact:hover .hc-contact__arrow {
      transform: rotate(-45deg) translateX(4px);
    }
    .hc-social:hover .hc-social__icon {
      background-color: var(--c-gold);
      transform: translateY(-3px);
    }
  }
  /* соцсети — у правого поля сетки, зеркально левому краю текста */
  .hc-social--tg {
    right: calc(60px + var(--col) + 42px);
  }
  .hc-social--vk {
    right: calc(60px + var(--col));
  }

  /* ── контент: x — от 2-й колонки сетки (153 при 1440), y — из макета, от центра экрана ── */
  .hero-tag,
  .hero-venue,
  .hero-address {
    left: calc(60px + var(--col) - 1.3px);
    font-size: 20px;
    line-height: 26px;
    white-space: nowrap;
  }
  /* плашка даты — «Squircle n=3.00 r=100px» 40 px, тёмно-синяя (Figma: main); маска — .sq40 в global.css */
  .hero-tag {
    top: calc(50% - 450px + 235px);
  }
  /* место проведения — голубым капсом над адресом */
  .hero-venue {
    top: calc(50% - 450px + 314px);
    color: rgb(49 168 243 / 0.8);
    font-weight: 300;
    line-height: 20px;
    letter-spacing: 3px;
    text-transform: uppercase;
  }
  .hero-tag span {
    display: block;
    width: max-content;
    height: 40px;
    padding: 9px 20px 5px 18px;
    background: var(--c-accent-2);
  }
  .hero-address {
    top: calc(50% - 450px + 342px);
  }
  .hero-logo {
    left: calc(60px + var(--col) - 2px);
    top: calc(50% - 450px + 439px);
    width: 534px;
    height: 75.37px;
  }
  .hero-logo img {
    width: 534px;
    height: 75.37px;
  }
  .hero-lead {
    left: calc(60px + var(--col) - 2px);
    top: calc(50% - 450px + 545px);
    width: 433px;
    font-size: 20px;
    line-height: 30px;
  }
  .hero__ui :global(.hero-btn) {
    left: calc(60px + var(--col));
    top: calc(50% - 450px + 676px);
  }

  /* ── мобильный (Figma: «main · mobile»): кадр 375 по ширине, KV сверху, текст от низа ── */
  @media (max-aspect-ratio: 1/1) {
    .hero__canvas {
      left: 0;
      top: 0;
      width: 100%;
      height: 64%;
      transform: none;
    }
    /* видео крупнее блока KV (Figma: 1112×626 со сдвигом −537, −106 в кадре 375×520) — в процентах от KV */
    .hero__video {
      left: -143.2%;
      top: -20.38%;
      width: 296.53%;
      height: 120.38%;
      background-position: 50% 50%;
    }
    .hero__video video,
    .hero__video :global(.hero__video-img) {
      object-position: 50% 50%;
      transform: none;
    }
    /* затемнение 140–524 в кадре 812 */
    .hero__shade-mob {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: 17.24%;
      height: 47.29%;
      background: linear-gradient(to bottom, rgb(0 1 11 / 0), #00010b);
      pointer-events: none;
    }
    .hc-partner,
    .hc-contact {
      display: none;
    }
    /* «Меню»: две золотые линии (30 и 13, по правому краю) и подпись; кнопка шире рисунка — палец попадает легко */
    .hc-menu {
      display: block;
      left: 13px;
      top: 18px;
      width: 100px;
      height: 40px;
      padding: 0;
      border: 0;
      background: none;
      color: #fff;
      font: inherit;
      cursor: pointer;
      pointer-events: auto;
      -webkit-tap-highlight-color: transparent;
    }
    .hc-menu__lines::before,
    .hc-menu__lines::after {
      content: '';
      position: absolute;
      right: 62px;
      height: 1px;
      background: #fce39c;
    }
    .hc-menu__lines::before {
      top: 15.5px;
      width: 30px;
    }
    .hc-menu__lines::after {
      top: 22.5px;
      width: 13px;
    }
    .hc-menu__label {
      position: absolute;
      left: 49px;
      top: 8px;
      font-size: 16px;
      line-height: 22px;
    }
    .hc-social {
      top: 26px;
    }
    .hc-social--tg {
      right: 52px;
    }
    .hc-social--vk {
      right: 16px;
    }
    /* плашка даты: тёмно-синий сквиркл 150×30 (Figma: «main · mobile»), .sq40 тянется по высоте */
    .hero-tag {
      left: 22px;
      top: calc(100% - 424px);
      font-size: 15px;
      line-height: 19.5px;
    }
    .hero-tag span {
      --sq-h: 30px;
      height: 30px;
      padding: 6.5px 16px 4px 13.5px;
    }
    .hero-venue {
      left: 23px;
      top: calc(100% - 382px);
      font-size: 13px;
      line-height: 20px;
      letter-spacing: 1.95px;
    }
    .hero-address {
      left: 23px;
      top: calc(100% - 362px);
      font-size: 14px;
      line-height: 22px;
    }
    .hero-logo,
    .hero-logo img {
      left: 16px;
      width: 335px;
      height: 47.28px;
    }
    .hero-logo {
      top: calc(100% - 289.5px);
    }
    .hero-lead {
      left: 16px;
      top: calc(100% - 223px);
      width: 320px;
      font-size: 16px;
      line-height: 22px;
    }
    /* кнопка по центру (Figma: «btm» 195×50) */
    .hero__ui :global(.hero-btn) {
      left: 0;
      right: 0;
      width: max-content;
      margin-inline: auto;
      top: calc(100% - 98px);
    }

    /*
     * Партнёры под первым экраном: 284 px кадра, сетка 2×2 с центрами колонок на 99 и 276 (±88.5 от центра).
     * Логотипы и подписи — те же, что в шапке десктопа, крупнее в 1.0985 раза: низ логотипов на 60.7 и 162.6.
     * Фон — от тёмно-синего первого экрана к чёрному «Что мы придумали?», чтобы не было ступеньки на стыке.
     */
    .hero-partners {
      display: block;
      position: relative;
      height: calc(284px * var(--ui-s));
      background: linear-gradient(#00010b, var(--c-bg));
      color: #fff;
    }
    .hero-partners__ui {
      --k: 1.0985;
      position: absolute;
      left: 0;
      top: 0;
      display: grid;
      grid-template-columns: repeat(2, 177px);
      justify-content: center;
      align-content: start;
      row-gap: 35.06px;
      width: var(--ui-w);
      height: 284px;
      margin: 0;
      padding: 20.9px 0 0;
      list-style: none;
      transform: scale(var(--ui-s));
      transform-origin: 0 0;
    }
  }
</style>
