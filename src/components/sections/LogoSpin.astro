---
/**
 * 05 · Логотип в снегу (Figma: кадр «2», слой «festive-glass-logo»).
 * Видео не играет само: пока блок поднимается через экран, скролл перематывает его,
 * и логотип поворачивается вокруг своей оси (вниз — вперёд, вверх — назад).
 * Верх кадра чёрный — стык с расписанием, низ белый — стык с программой MVP Talks.
 * Логика — scripts/sections/logo-spin.ts
 */
import { logoSpin } from '../../data/content';
import { withBase } from '../../lib/paths';
---

<section class="spin" data-spin aria-hidden="true">
  <video
    class="spin__video"
    src={withBase(logoSpin.video)}
    poster={withBase(logoSpin.poster)}
    width="1920"
    height="1168"
    muted
    playsinline
    preload="none"
    data-spin-video></video>
  <!-- снег и белый низ кадра: меню над ними переключается на тёмный текст (scripts/ui/nav.ts) -->
  <i class="spin__light" data-nav-light></i>
</section>

<style>
  .spin {
    position: relative;
    background: var(--c-bg);
  }
  .spin__video {
    width: 100%;
    height: auto;
    aspect-ratio: 1920 / 1168;
    object-fit: cover;
  }
  .spin__light {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 38%;
    pointer-events: none;
  }
  /* мобильный (Figma: «2 · mobile» → «05 · Логотип в снегу»): кадр 375×431, по бокам обрезан —
     логотип остаётся крупным. Чёрный верх заходит на расписание на 72 px, белый низ уходит
     под программу MVP Talks на 56 px (её заголовок стоит на снегу) */
  @media (max-aspect-ratio: 1/1) {
    .spin {
      margin-top: calc(-72px * var(--ui-s));
      margin-bottom: calc(-56px * var(--ui-s));
    }
    .spin__video {
      aspect-ratio: auto;
      height: calc(431px * var(--ui-s));
    }
  }
</style>
