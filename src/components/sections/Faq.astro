---
/**
 * 10 · FAQ — аккордеон на <details>, высота анимируется (scripts/ui/accordion.ts).
 * Без JS работает как обычный нативный аккордеон.
 */
import Anno from '../ui/Anno.astro';
import { faq } from '../../data/content';
---

<section class="section faq" id="faq">
  <Anno kind="screen">10 · FAQ</Anno>
  <div class="container faq__grid">
    <div class="faq__head">
      <h2 class="h2" data-split>{faq.title}</h2>
      <Anno kind="motion">плавное раскрытие ответа · плюс поворачивается в крестик</Anno>
    </div>
    <div class="faq__list" data-accordion data-stagger>
      {
        faq.items.map((item) => (
          <details class="faq__item">
            <summary class="faq__q">
              <span>{item.q}</span>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <div class="faq__a">
              <p class:list={{ fish: item.draft }}>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: 48px;
  }
  .faq__head {
    position: sticky;
    top: 12vh;
    align-self: start;
  }
  .faq__item {
    border-bottom: 1px solid var(--c-line);
  }
  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
    font-size: clamp(17px, 1.6vw, 21px);
    font-weight: 500;
    list-style: none;
    cursor: pointer;
    transition: opacity 0.3s;
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__q:hover {
    opacity: 0.75;
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    transition: transform 0.5s var(--ease-out);
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 2px;
    margin: -1px 0 0 -9px;
    background: currentColor;
  }
  .faq__icon::after {
    transform: rotate(90deg);
  }
  .faq__item[open]:not(.is-closing) .faq__icon {
    transform: rotate(45deg);
  }
  .faq__a {
    overflow: hidden;
  }
  .faq__a p {
    max-width: 60ch;
    padding-bottom: 24px;
    color: var(--c-muted);
  }
  @media (max-width: 860px) {
    .faq__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .faq__head {
      position: static;
    }
  }
</style>
