---
/**
 * 07 · Спортивный квиз (Figma: кадр «2» — низ; состояния карусели — кадры «Как всё пройдёт? FRAME»
 * 4204:4529 (вход в блок) и 4204:4575 (дошли до текста)).
 * Тёмная плашка-«сквиркл» на градиенте (белый → синий → почти чёрный): заголовок, пункты
 * «Настраиваемся • Играем • Кайфуем», темы вопросов плашками, текст, кнопка.
 *
 * Карусель иконок (scripts/sections/quiz-orbit.ts). Главные условия:
 *   1. расстояния между иконками ОДИНАКОВЫЕ — между краями соседних всегда один и тот же зазор;
 *   2. карусель идёт на всю ширину экрана и уходит за оба края, по кругу без конца;
 *   3. перспектива — по центру самая крупная, к краям меньше; все стоят на одной прямой.
 * При входе в блок карусель стоит под темами, на начале текста; когда доходишь до текста —
 * поднимается на темы и открывает текст. Скролл ещё и прокручивает её по горизонтали.
 *
 * Десктоп: блок 1607 px макета, всё на местах из макета; снизу к нему примыкает «Кто будет?». Мобильный: содержимое идёт потоком
 * (высоту блока ставит fitFlow), плашка тянется под ним; у карусели своя строка между темами и текстом —
 * она стоит на месте и не закрывает текст, только медленно идёт сама.
 */
import Anno from '../ui/Anno.astro';
import Button from '../ui/Button.astro';
import { event, quiz } from '../../data/content';
import { withBase } from '../../lib/paths';
import { paragraph } from '../../lib/text';

// 24 места: каждая иконка дважды, чтобы цепочки хватало на любой ширине экрана
const ring = [...quiz.icons, ...quiz.icons];
---

<section
  class="quiz"
  id="quiz"
  data-quiz
  style={['tl', 'tr', 'bl', 'br'].map((k) => `--plate-${k}:url(${withBase(`/media/quiz/plate-m-${k}.svg`)})`).join(';')}
>
  <div class="quiz__ui" data-quiz-ui data-flow>
    <div class="quiz__plate" aria-hidden="true"></div>

    <h2 class="quiz__title" data-split>{quiz.title[0]}<br /><span class="accent">{quiz.title[1]}</span></h2>

    <p class="quiz__steps" data-quiz-steps>
      {
        quiz.steps.map((step, i) => (
          <>
            {i > 0 && <span class="quiz__dot" aria-hidden="true">•</span>}
            <span class="quiz__step" data-quiz-step>{step}</span>
          </>
        ))
      }
    </p>

    <ul class="quiz__topics" data-quiz-topics>
      {
        quiz.topics.map((row) => (
          <li class="quiz__row">
            <ul class="quiz__row-list">
              {row.map((topic) => (
                <li class="quiz__topic" data-rise>{topic}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <!-- мобильный: своя строка карусели между темами и текстом — лента стоит здесь и ничего не закрывает -->
    <div class="quiz__orbit-slot" data-orbit-slot aria-hidden="true"></div>

    <div class:list={['quiz__lead', { fish: quiz.draft }]} data-quiz-lead>
      {
        quiz.paragraphs.map((p, i) => (
          <p>
            {paragraph(p, quiz.paragraphsMobile[i]).map((t, j, all) => (
              <>
                {t.word}
                {j < all.length - 1 && ' '}
                {t.d && <br class="br-d" />}
                {t.m && <br class="br-m" />}
              </>
            ))}
          </p>
        ))
      }
    </div>

    <div class="quiz__cta">
      <Button href={event.quizRegisterUrl}>{quiz.cta}</Button>
    </div>

    <div class="orbit" data-orbit aria-hidden="true">
      {
        ring.map((icon) => (
          <div class="orbit__item" data-orbit-item data-ratio={icon.ratio}>
            <picture>
              <source srcset={withBase(`/media/quiz/${icon.name}.avif`)} type="image/avif" />
              <img src={withBase(`/media/quiz/${icon.name}.png`)} alt="" width="260" height="260" loading="lazy" decoding="async" />
            </picture>
          </div>
        ))
      }
    </div>
  </div>
  <Anno kind="screen">07 · Спортивный квиз</Anno>
</section>

<style>
  /* фон макета (Rectangle 5881): белый до 11.5% → синий #013a8b к 46.7% → #030f1c к 97% */
  .quiz {
    position: relative;
    height: calc(1607px * var(--ui-s));
    overflow: hidden;
    background-color: #fff;
    background-image: var(--dither), linear-gradient(to bottom, rgb(1 58 139 / 0) 11.531%, #013a8b 46.68%, #030f1c 96.998%);
    background-size: var(--dither-size), auto;
    background-repeat: repeat, no-repeat;
    color: var(--c-text);
  }
  .quiz__ui {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--ui-w);
    height: 1607px;
    transform: scale(var(--ui-s));
    transform-origin: 0 0;
  }
  .quiz__ui > * {
    position: absolute;
  }

  /* десктоп: блок короче — фон приходит в цвет «Кто будет?» (#04101d) к самому низу блока, без шва */
  @media not all and (max-aspect-ratio: 1/1) {
    .quiz {
      background-image: var(--dither), linear-gradient(
        to bottom,
        rgb(1 58 139 / 0) calc(222.7px * var(--ui-s)),
        #013a8b calc(901px * var(--ui-s)),
        #04101d calc(1590px * var(--ui-s))
      );
    }
  }

  /* плашка 1320×1352 при 1440: поля 60, сквиркл r=260 (n=3) */
  .quiz__plate {
    z-index: 2;
    left: 60px;
    top: 110px;
    width: calc(var(--ui-w) - 120px);
    height: 1352px;
    border-radius: 260px;
    background: #030f1c;
    /* свечение не выходит за форму плашки (в макете — маска по сквирклу) */
    overflow: hidden;
  }
  /* свечение у низа плашки (Figma: Mask group 4205:4648): два размытых круга, центры ниже края плашки.
     Большой — голубой akcent, размытие 193; малый — светлее, в режиме overlay, размытие 77 */
  .quiz__plate::before,
  .quiz__plate::after {
    content: '';
    position: absolute;
    left: 50%;
    border-radius: 50%;
    pointer-events: none;
  }
  .quiz__plate::before {
    bottom: -392px;
    width: 556px;
    height: 556px;
    margin-left: -278px;
    background: var(--c-accent);
    filter: blur(193px);
  }
  .quiz__plate::after {
    bottom: -209px;
    width: 281px;
    height: 281px;
    margin-left: -140.5px;
    background: #61c2ff;
    filter: blur(77px);
    mix-blend-mode: overlay;
  }
  @supports (corner-shape: squircle) {
    .quiz__plate {
      corner-shape: superellipse(1.585);
    }
  }

  /* текст — над плашкой; иконки карусели — ещё выше (z-index ставит quiz-orbit.ts) */
  .quiz__title,
  .quiz__steps,
  .quiz__topics,
  .quiz__lead,
  .quiz__cta {
    z-index: 3;
    left: 0;
    width: 100%;
    text-align: center;
  }
  .accent {
    color: var(--c-accent);
  }
  .quiz__title {
    top: 234px;
    font-size: 65px;
    font-weight: 300;
    line-height: 80px;
    letter-spacing: -3.25px;
  }

  /* «Настраиваемся • Играем • Кайфуем» — одна строка 35/45, точки акцентные */
  .quiz__steps {
    top: 444px;
    display: flex;
    justify-content: center;
    gap: 22px;
    font-size: 35px;
    font-weight: 300;
    line-height: 45px;
    letter-spacing: -1.75px;
    white-space: nowrap;
  }
  .quiz__step {
    display: inline-block;
  }
  .quiz__dot {
    color: var(--c-accent);
  }

  /* темы: плашки 61 px, три строки по центру, между строками 19.6, между плашками 8 */
  .quiz__topics {
    top: 531px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 19.6px;
  }
  .quiz__row-list {
    display: flex;
    justify-content: center;
    gap: 8px;
  }
  .quiz__topic {
    display: inline-flex;
    align-items: center;
    height: 61.08px;
    padding: 14.54px 34.9px 5.82px 36.36px;
    border-radius: 145px;
    background: var(--c-accent-2);
    color: #fff;
    font-size: 29.085px;
    line-height: 40.72px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .quiz__lead {
    top: 842px;
    left: 50%;
    width: 694px;
    margin-left: -347px;
    font-size: 26px;
    line-height: 1.45;
  }
  .quiz__lead p + p {
    margin-top: 1.45em;
  }
  .quiz__cta {
    top: 1298px;
    display: flex;
    justify-content: center;
  }
  .quiz__cta :global(.btn) {
    min-width: 235px;
  }

  /* строка карусели — только в мобильном потоке (ниже); на десктопе карусель ездит по макету */
  .quiz__orbit-slot {
    display: none;
  }

  /* карусель: слой во весь кадр, у самого слоя нет z-index — иконки встают над плашкой и текстом */
  .orbit {
    inset: 0;
    pointer-events: none;
  }
  .orbit__item {
    position: absolute;
    left: 0;
    top: 0;
    width: 260px;
    height: 260px;
    /* показывает скрипт, когда поставит иконку на место */
    visibility: hidden;
    will-change: transform;
  }
  .orbit__item img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* мобильный («2 · mobile» → «06»): плашка во всю ширину, скругление 74; содержимое идёт потоком,
     пункты — столбиком, темы переносятся по ширине */
  @media (max-aspect-ratio: 1/1) {
    /* снизу: кнопка → низ плашки 79, плашка → «Кто будет?» 29 (Figma: «06 · Квиз · низ плашки») */
    .quiz__ui {
      height: auto;
      padding: 130px 16px 108px;
    }
    .quiz__ui > * {
      position: relative;
    }
    /* плашка и слой карусели остаются поверх потока (селектор сильнее правила выше) */
    /*
     * Плашка — сквиркл из мобильного макета («Squircle n=3.00 r=260px», 375×954: углы ~74 px). Высота плашки
     * зависит от текста, поэтому форма собрана маской из четырёх углов (media/quiz/plate-m-*.svg) и двух полос.
     * Полосы заходят внутрь углов, где форма сплошная, — на стыках нет швов.
     */
    .quiz__ui > .quiz__plate {
      position: absolute;
      left: 0;
      top: 63px;
      bottom: 29px;
      width: var(--ui-w);
      height: auto;
      border-radius: 0;
      --strip: linear-gradient(#000, #000);
      -webkit-mask:
        var(--plate-tl) left top / 100px 100px no-repeat,
        var(--plate-tr) right top / 100px 100px no-repeat,
        var(--plate-bl) left bottom / 100px 100px no-repeat,
        var(--plate-br) right bottom / 100px 100px no-repeat,
        var(--strip) center / calc(100% - 196px) 100% no-repeat,
        var(--strip) center / 100% calc(100% - 196px) no-repeat;
      mask:
        var(--plate-tl) left top / 100px 100px no-repeat,
        var(--plate-tr) right top / 100px 100px no-repeat,
        var(--plate-bl) left bottom / 100px 100px no-repeat,
        var(--plate-br) right bottom / 100px 100px no-repeat,
        var(--strip) center / calc(100% - 196px) 100% no-repeat,
        var(--strip) center / 100% calc(100% - 196px) no-repeat;
    }
    /* свечение мельче — плашка уже в 3.5 раза */
    .quiz__plate::before {
      bottom: -235px;
      width: 334px;
      height: 334px;
      margin-left: -167px;
      filter: blur(116px);
    }
    .quiz__plate::after {
      bottom: -125px;
      width: 169px;
      height: 169px;
      margin-left: -84.5px;
      filter: blur(46px);
    }
    .quiz__title,
    .quiz__steps,
    .quiz__topics,
    .quiz__lead,
    .quiz__cta {
      top: auto;
      left: auto;
      width: auto;
    }
    .quiz__title {
      font-size: 38px;
      line-height: 36px;
      letter-spacing: -1.9px;
    }
    .quiz__steps {
      flex-direction: column;
      align-items: center;
      gap: 4px;
      margin-top: 49px;
      font-size: 26px;
      line-height: 45px;
      letter-spacing: -1.3px;
    }
    .quiz__dot {
      display: none;
    }
    .quiz__topics {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px 8px;
      max-width: 360px;
      margin: 20px auto 0;
    }
    .quiz__row,
    .quiz__row-list {
      display: contents;
    }
    .quiz__topic {
      height: 32px;
      padding: 7px 16px 3px;
      font-size: 14px;
      line-height: 22px;
    }
    /* строка карусели: рамка центральной иконки 110 + воздух сверху и снизу */
    .quiz__ui > .quiz__orbit-slot {
      display: block;
      height: 110px;
      margin-top: 28px;
    }
    .quiz__lead {
      left: auto;
      width: auto;
      max-width: 343px;
      margin: 28px auto 0;
      font-size: 18px;
    }
    .quiz__lead p + p {
      margin-top: 26px;
    }
    .quiz__cta {
      margin-top: 60px;
    }
    .quiz__ui > .orbit {
      position: absolute;
    }
    .orbit__item {
      width: 110px;
      height: 110px;
    }
  }
</style>
