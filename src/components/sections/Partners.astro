---
/**
 * «Партнеры» (Figma: кадр «2»). Логотипы и подписи смешиваются с фоном в режиме color-dodge — как в макете:
 * там, где за логотипом свет эллипса, он вспыхивает, на тёмном почти гаснет. Эллипсы движутся
 * (scripts/sections/finale.ts), поэтому логотипы медленно разгораются и гаснут сами.
 * На наведении логотип становится полностью белым: поверх лежит его белая копия.
 *
 * Важно: у родителей логотипов не должно быть transform, opacity, filter и т.п. — иначе они отрежут логотип от фона
 * и смешивание перестанет работать. Появление — только прозрачностью самих картинок и подписей (finale.ts).
 */
import { partners } from '../../data/content';
import { withBase } from '../../lib/paths';
---

<section class="partners" id="partners">
  <h2 class="partners__title" data-split>{partners.title}</h2>
  <ul class="partners__list" data-partners>
    {
      partners.items.map((p) => (
        <li
          class="partner"
          style={`--x:${p.x - 720}px;--y:${p.y}px;--w:${p.w}px;--h:${p.h}px;--role-x:${p.roleX - p.x}px;--role-y:${p.roleY - p.y}px`}
        >
          <img class="partner__logo" src={withBase(p.logo)} width={p.w} height={p.h} alt={p.name} loading="lazy" />
          <img class="partner__logo partner__logo--white" src={withBase(p.logo)} width={p.w} height={p.h} alt="" loading="lazy" />
          <span class="partner__role">{p.role}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .partners {
    position: relative;
    height: 740px;
  }
  .partners__title {
    position: absolute;
    left: 0;
    top: 50px;
    width: 100%;
    font-size: 65px;
    font-weight: 300;
    line-height: 55px;
    letter-spacing: -3.25px;
    text-align: center;
    color: #fff;
  }
  .partner {
    position: absolute;
    left: calc(50% + var(--x));
    top: var(--y);
    width: var(--w);
    height: var(--h);
  }
  .partner__logo {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--w);
    height: var(--h);
    max-width: none;
    mix-blend-mode: color-dodge;
  }
  .partner__logo--white {
    mix-blend-mode: normal;
    filter: brightness(0) invert(1);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .partner:hover .partner__logo--white {
    opacity: 1;
  }
  /* зона наведения — вместе с подписью и небольшим запасом вокруг логотипа */
  .partner::after {
    content: '';
    position: absolute;
    inset: -20px -20px calc(var(--h) - var(--role-y) - 34px);
  }
  .partner__role {
    position: absolute;
    left: var(--role-x);
    top: var(--role-y);
    transform: translateX(-50%);
    color: var(--c-accent);
    font-size: 12px;
    line-height: 28px;
    letter-spacing: 0.48px;
    text-transform: uppercase;
    white-space: nowrap;
    mix-blend-mode: color-dodge;
    opacity: 0.55;
  }
  /* первая подпись стоит на самом ярком месте — в макете она просто белая */
  .partner:first-child .partner__role {
    color: #fff;
    mix-blend-mode: normal;
    opacity: 0.3;
  }
</style>
