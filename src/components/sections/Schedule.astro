---
/**
 * 04 · «Как всё пройдёт?» (Figma: кадр «2», мобильный — «2 · mobile» → «04»).
 * Десктоп: экран закреплён, заголовок слева стоит, программа дня справа едет «гармошкой».
 * Мобильный: без закрепления — шапка по центру, пункты идут обычным потоком.
 * Логика — scripts/sections/schedule.ts
 */
import Anno from '../ui/Anno.astro';
import { event, schedule } from '../../data/content';
const lines = (text: string) => text.split('\n');
---

<!-- data-story-row: на мобильном фон — кусок общего градиента с этой строки макета (Story.astro) -->
<section class="schedule stage" id="schedule" data-schedule data-story-row style="--story-row: 1467px">
  <div class="stage__ui" data-flow>
    <p class="schedule__date label" data-split="dark">{event.date} · {event.venue}</p>
    <h2 class="schedule__title">
      <span class="schedule__line" data-split>{schedule.title}</span>
      <span class="schedule__line schedule__line--accent accent" data-split>{schedule.accent}</span>
    </h2>

    <ol class="schedule__list" data-schedule-list>
      {
        schedule.items.map((it) => (
          <li class:list={['sch', it.key && 'sch--key', it.list && 'sch--wide']}>
            <span class="time-pill" data-rise>{it.time}</span>
            <h3 class="sch__title" data-lines>{it.title}</h3>
            {it.text && (
              <p class="sch__text" data-lines>
                {lines(it.text).map((line, i) => (
                  <>
                    {i > 0 && <>{' '}<br class="br-d" /></>}
                    {line}
                  </>
                ))}
              </p>
            )}
            {it.list && (
              <ul class="sch__chips">
                {it.list.map((x) => (
                  <li class="pill" data-rise>{x}</li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </div>
  <Anno kind="screen">04 · Как всё пройдёт?</Anno>
</section>

<style>
  .schedule {
    color: var(--c-text);
    /* нижние 300 px макета: у края экрана прозрачность 0, к верху полосы — 100% */
    -webkit-mask-image: linear-gradient(to top, transparent 0, #000 calc(300px * var(--ui-s)));
    mask-image: linear-gradient(to top, transparent 0, #000 calc(300px * var(--ui-s)));
  }
  .schedule__date {
    left: calc(60px + var(--col));
    top: calc(50% - 450px + 158px);
    width: 527px;
    line-height: 33px;
  }
  /* 65/65, вторая строка с отступом 110 (как в макете) */
  .schedule__title {
    left: calc(60px + var(--col));
    top: calc(50% - 450px + 228px);
    width: 527px;
    font-size: 65px;
    font-weight: 300;
    line-height: 65px;
    letter-spacing: -3.25px;
    white-space: nowrap;
  }
  .schedule__line {
    display: block;
  }
  .schedule__line--accent {
    margin-left: 110px;
  }
  .accent {
    color: var(--c-accent);
  }
  /* список — от 9-й колонки (816 при 1440), между пунктами 50 */
  .schedule__list {
    left: calc(60px + var(--col) * 8 - 4px);
    top: calc(50% - 450px + 219px);
    width: 525px;
    will-change: transform;
  }
  .sch {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    width: 393px;
    font-weight: 300;
  }
  .sch + .sch {
    margin-top: 50px;
  }
  .sch--key {
    gap: 20px;
    width: 472px;
  }
  .sch--wide {
    width: 525px;
  }
  .sch__title {
    font-size: 22px;
    font-weight: 300;
    line-height: 32px;
  }
  .sch--key .sch__title {
    font-size: 35px;
    line-height: 45px;
    letter-spacing: -1.75px;
  }
  .sch__text {
    font-size: 22px;
    line-height: 32px;
  }
  .sch__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10.4px 10px;
    max-width: 500px;
    margin-top: -16px;
  }
  /* десктоп: высоты пунктов из макета после смены плашки времени на сквиркл 40 px */
  @media not all and (max-aspect-ratio: 1/1) {
    .sch {
      gap: 20px;
    }
    .sch:not(.sch--key) {
      height: 88px;
    }
    .sch--key {
      min-height: 263px;
    }
    .sch--wide {
      margin-bottom: 8px;
    }
    .sch--key:last-child {
      min-height: 213px;
    }
  }

  /* мобильный (Figma: «2 · mobile» → «04 · Как всё пройдёт?»): обычный поток без закрепления —
     дата и заголовок по центру, пункты через 29 px (высоту блока по содержимому ставит stage.ts → fitFlow) */
  @media (max-aspect-ratio: 1/1) {
    .schedule {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .schedule > .stage__ui {
      height: auto;
      padding: 40px 16px 96px;
    }
    .schedule > .stage__ui > * {
      position: relative;
    }
    .schedule__date {
      left: auto;
      top: auto;
      width: auto;
      color: rgb(41 123 242 / 0.8);
      font-size: 13px;
      letter-spacing: 1.95px;
      line-height: 20px;
      text-align: center;
    }
    .schedule__title {
      left: auto;
      top: auto;
      width: auto;
      margin-top: 26px;
      font-size: 38px;
      line-height: 36px;
      letter-spacing: -1.9px;
      text-align: center;
    }
    .schedule__line {
      display: inline-block;
    }
    .schedule__line--accent {
      margin-left: 0.25em;
    }
    .schedule__list {
      left: auto;
      top: auto;
      width: auto;
      max-width: 480px;
      margin: 60px auto 0;
      will-change: auto;
    }
    .sch,
    .sch--key,
    .sch--wide {
      width: 100%;
      gap: 16px;
    }
    .sch + .sch {
      margin-top: 29px;
    }
    .sch__title,
    .sch__text {
      font-size: 18px;
      line-height: 26px;
    }
    .sch--key .sch__title {
      font-size: 30px;
      line-height: 32px;
      letter-spacing: -1.5px;
    }
    .sch__chips {
      gap: 10px;
      margin-top: 4px;
    }
    .sch__chips :global(.pill) {
      height: 32px;
      padding: 7px 16px 3px;
      font-size: 14px;
      line-height: 22px;
    }
  }
</style>
