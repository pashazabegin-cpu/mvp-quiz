---
/** Плавающее меню внизу экрана. Активный пункт и «бегунок» — scripts/ui/nav.ts */
import { event, nav } from '../../data/content';
import Button from './Button.astro';
---

<nav class="nav" data-nav data-glass aria-label="Разделы страницы">
  <!-- стекло: фильтр фона (scripts/effects/liquid-glass.ts) и блики поверх -->
  <span class="nav__glass" aria-hidden="true"><span class="nav__lens" data-glass-lens></span><span class="nav__sheen"></span></span>
  <div class="nav__links" data-nav-links>
    <span class="nav__indicator" data-nav-indicator aria-hidden="true"></span>
    {
      nav.map((item) => (
        <a class="nav__link" href={`#${item.id}`} data-nav-link={item.id}>
          {item.label}
        </a>
      ))
    }
  </div>
  <Button href={event.ticketUrl} class="nav__cta">Билеты</Button>
</nav>

<style>
  .nav {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 20px;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 6px;
    width: max-content;
    max-width: calc(100vw - 32px);
    margin-inline: auto;
    padding: 6px;
    border-radius: var(--radius-pill);
    transition: opacity 0.5s var(--ease-out), transform 0.6s var(--ease-out);
  }
  /* Стекло — отдельным слоем: backdrop-filter на самой .nav отрезал бы фон страницы от линзы.
     Лёгкий тон, светлая кромка сверху, без тени. */
  .nav__glass {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: rgb(255 255 255 / 0.04);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.1),
      inset 0 1px 0 rgb(255 255 255 / 0.16);
    pointer-events: none;
  }
  .nav__lens {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    backdrop-filter: blur(18px) saturate(150%);
  }
  /* Chromium: преломляющий фильтр. Слой шире плашки на --glass-reach, чтобы край брал картинку снаружи,
     видна только сама плашка */
  .nav.is-refracting .nav__lens {
    inset: calc(var(--glass-reach) * -1px);
    border-radius: 0;
    clip-path: inset(calc(var(--glass-reach) * 1px) round 999px);
  }
  /* два мягких блика медленно плывут по стеклу */
  .nav__sheen {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
  }
  .nav__sheen::before {
    content: '';
    position: absolute;
    inset: -60% -20%;
    background:
      radial-gradient(28% 70% at 30% 40%, rgb(255 255 255 / 0.09), transparent 70%),
      radial-gradient(22% 60% at 72% 62%, rgb(255 255 255 / 0.06), transparent 70%);
    animation: nav-sheen 12s ease-in-out infinite alternate;
  }
  @keyframes nav-sheen {
    to {
      transform: translateX(14%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav__sheen::before {
      animation: none;
    }
  }
  /* на первом экране меню нет (как в макете) — появляется, когда обложка уезжает (scripts/ui/nav.ts) */
  :global(html.js-motion:not(.is-past-hero)) .nav {
    opacity: 0;
    transform: translateY(24px);
    pointer-events: none;
  }
  .nav__links {
    position: relative;
    display: flex;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav__links::-webkit-scrollbar {
    display: none;
  }
  .nav__link {
    position: relative;
    z-index: 1;
    padding: 12px 16px;
    border-radius: var(--radius-pill);
    color: var(--c-muted);
    font-size: 14px;
    white-space: nowrap;
    transition: color 0.3s;
  }
  .nav__link:hover,
  .nav__link.is-active {
    color: var(--c-text);
  }
  .nav__indicator {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 100%;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.1);
    opacity: 0;
  }
  /* над белым экраном (scripts/ui/nav.ts): стекло светлее, текст тёмно-синий */
  .nav__glass,
  .nav__link,
  .nav__indicator {
    transition:
      background-color 0.4s,
      box-shadow 0.4s,
      color 0.4s;
  }
  .nav--light .nav__glass {
    background-color: rgb(255 255 255 / 0.45);
    box-shadow:
      inset 0 0 0 1px rgb(14 70 151 / 0.12),
      inset 0 1px 0 rgb(255 255 255 / 0.9);
  }
  .nav--light .nav__link {
    color: rgb(14 70 151 / 0.6);
  }
  .nav--light .nav__link:hover,
  .nav--light .nav__link.is-active {
    color: var(--c-accent-2);
  }
  .nav--light .nav__indicator {
    background-color: rgb(14 70 151 / 0.08);
  }
  .nav :global(.nav__cta) {
    flex: none;
    min-width: 0;
    height: 46px;
    padding: 2px 22px 0;
  }
  /* мобильная раскладка (тот же запрос, что MOBILE_QUERY в scripts/core/stage.ts): нижнего меню нет —
     навигация будет бургером на первом экране */
  @media (max-aspect-ratio: 1/1) {
    .nav {
      display: none;
    }
  }
</style>
