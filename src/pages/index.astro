---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Story from '../components/sections/Story.astro';
import Intro from '../components/sections/Intro.astro';
import Program from '../components/sections/Program.astro';
import Schedule from '../components/sections/Schedule.astro';
import LogoSpin from '../components/sections/LogoSpin.astro';
import Talks from '../components/sections/Talks.astro';
import Quiz from '../components/sections/Quiz.astro';
import Finale from '../components/sections/Finale.astro';
import Speakers from '../components/sections/Speakers.astro';
import Tickets from '../components/sections/Tickets.astro';
import Partners from '../components/sections/Partners.astro';
import Location from '../components/sections/Location.astro';
import Faq from '../components/sections/Faq.astro';
import Footer from '../components/sections/Footer.astro';
import MobileMenu from '../components/ui/MobileMenu.astro';
---

<!--
  Страница собирается по макету сверху вниз. Жюри (Jury — прототип в components/sections) пока снято со страницы.
-->
<Base>
  <main>
    <Hero />          <!-- 01 Первый экран — по макету; на мобильном под ним блок партнёра -->
    <Story>           <!-- общий фон-градиент для трёх экранов ниже -->
      <Intro />       <!-- 02 Что мы придумали? — по макету -->
      <Program />     <!-- 03 Что будет?: три пункта дня — по макету -->
      <Schedule />    <!-- 04 Как всё пройдёт? — по макету -->
    </Story>
    <LogoSpin />      <!-- 05 Логотип в снегу: видео перематывается скроллом -->
    <Talks />         <!-- 06 Программа MVP Talks — белый экран -->
    <Quiz />          <!-- 07 Спортивный квиз — плашка с орбитой иконок -->
    <Finale>          <!-- общий кадр и большие эллипсы низа страницы; только десктоп: мобильного макета пока нет -->
      <Speakers />    <!-- 08 Кто будет? — карусель -->
      <Tickets />     <!-- 09 Купить билет — голографический билет, снег -->
      <Partners />    <!-- 10 Партнеры — логотипы смешиваются с фоном -->
      <Location />    <!-- 11 Локация — карта, фото с параллаксом -->
      <Faq />         <!-- 12 FAQ -->
      <Footer />      <!-- 13 Подвал -->
    </Finale>
  </main>
  <MobileMenu />      <!-- мобильное меню: открывается кнопкой «Меню» на первом экране -->
</Base>
