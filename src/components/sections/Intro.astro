---
/**
 * 02 · «Что мы придумали?» (Figma: кадр «main»/«START» 1440×900, мобильный — «2 · mobile»).
 * Экран закреплён: текст закрашивается по словам, теги/снежинки/фото проезжают снизу вверх
 * на разной глубине — в середине пути стоят ровно как в макете (кадр «2»).
 * Логика — scripts/sections/intro.ts
 */
import Anno from '../ui/Anno.astro';
import { intro } from '../../data/content';
import { withBase } from '../../lib/paths';

// абзац с переносами обоих макетов: слова совпадают, \n отмечает перенос после слова
// (d — в десктопном, m — в мобильном), поэтому идём по словам двух версий параллельно
const tokens = (text: string) => {
  const out: { word: string; br: boolean }[] = [];
  for (const part of text.split(/(\s+)/)) {
    if (!part) continue;
    if (!/^\s+$/.test(part)) out.push({ word: part, br: false });
    else if (part.includes('\n') && out.length) out[out.length - 1].br = true;
  }
  return out;
};
const paragraph = (desktop: string, mobile: string) => {
  const m = tokens(mobile);
  return tokens(desktop).map((t, i) => ({ word: t.word, d: t.br, m: m[i]?.br ?? false }));
};
// позиция на сцене: десктоп — доля ширины кадра 1440 и px кадра 900, мобильный — доля 375 и px кадра 688
const floatStyle = (f: (typeof intro.floats)[number]) =>
  [
    `--x:${((f.x / 1440) * 100).toFixed(3)}%;--y:${f.y}px`,
    'w' in f && f.w ? `--w:${f.w}px;--h:${f.h}px` : '',
    'm' in f && f.m ? `--mx:${((f.m.x / 375) * 100).toFixed(3)}%;--my:${f.m.y}px;--mw:${f.m.w}px` : '',
  ]
    .filter(Boolean)
    .join(';');
---

<section class="intro stage" id="about" data-intro-section>
  <div class="stage__ui">
    <h2 class="intro__title" data-split>
      {intro.title[0]}<br /><span class="accent">{intro.title[1]}</span>
    </h2>
    <div class="intro__lead" data-intro-lead>
      {
        intro.paragraphs.map((p, i) => (
          <p>
            {paragraph(p, intro.paragraphsMobile[i]).map((t, j, all) => (
              <>
                {t.word}
                {j < all.length - 1 && ' '}
                {t.d && <br class="br-d" />}
                {t.m && <br class="br-m" />}
              </>
            ))}
          </p>
        ))
      }
    </div>
    <div class="intro__floats" aria-hidden="true">
      {
        intro.floats.map((f) => (
          <div
            class:list={[
              'intro__float',
              `intro__float--${f.kind}`,
              'back' in f && f.back && 'intro__float--back',
              !('m' in f) && 'intro__float--no-m',
              'mobileOnly' in f && f.mobileOnly && 'intro__float--m-only',
            ]}
            data-float
            data-z={f.z}
            style={floatStyle(f)}
          >
            {f.kind === 'tag' ? (
              <span class="pill" style={`--pill:var(${f.color === 'accent' ? '--c-accent' : '--c-accent-2'})`}>
                {f.text}
              </span>
            ) : (
              <img src={withBase(f.src!)} width={f.w} height={f.h} alt="" loading="lazy" decoding="async" />
            )}
          </div>
        ))
      }
    </div>
  </div>
  <Anno kind="screen">02 · Что мы придумали?</Anno>
</section>

<style>
  .intro {
    color: var(--c-text);
  }
  .intro__title {
    left: 50%;
    top: calc(50% - 450px + 110px);
    width: 380px;
    margin-left: -190px;
    font-size: 45px;
    font-weight: 300;
    line-height: 45px;
    letter-spacing: -2.25px;
    text-align: center;
  }
  .accent {
    color: var(--c-accent);
  }
  .intro__lead {
    left: 50%;
    top: calc(50% - 450px + 349px);
    width: 750px;
    margin-left: -375px;
    font-size: 26px;
    line-height: 1.45;
    text-align: center;
  }
  .intro__lead p + p {
    margin-top: 1.45em;
  }
  /* слой проезжающих элементов: по вертикали — кадр 900, по горизонтали растянут на весь экран
     (x — доля ширины кадра 1440), чтобы крайние снежинки оставались у краёв на широких экранах */
  .intro__floats {
    left: 0;
    top: calc(50% - 450px);
    width: 100%;
    height: 900px;
    pointer-events: none;
  }
  .intro__float {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w, auto);
    height: var(--h, auto);
    will-change: transform;
  }
  /* дальний план — за текстом */
  .intro__float--back {
    z-index: -1;
  }
  /* фото вписаны в рамку 179×201 целиком, как в макете (пропорции у снимков разные) */
  .intro__float img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* элемент только для мобильного кадра */
  .intro__float--m-only {
    display: none;
  }

  /* мобильный кадр 375×688 по центру экрана (Figma: «2 · mobile» → «02 · Что мы придумали?»):
     теги и фото убраны, снежинки на своих местах, x — доля ширины кадра */
  @media (max-aspect-ratio: 1/1) {
    .intro__title {
      top: calc(50% - 344px + 95px);
      width: 300px;
      margin-left: -150px;
      font-size: 34px;
      line-height: 36px;
      letter-spacing: -1.7px;
    }
    .intro__lead {
      top: calc(50% - 344px + 229px);
      width: 343px;
      margin-left: -171.5px;
      font-size: 18px;
    }
    .intro__lead p + p {
      margin-top: 26px;
    }
    .intro__floats {
      top: calc(50% - 344px);
      height: 688px;
    }
    .intro__float {
      left: var(--mx);
      top: var(--my);
      width: var(--mw);
      height: auto;
    }
    .intro__float img {
      height: auto;
    }
    .intro__float--no-m {
      display: none;
    }
    .intro__float--m-only {
      display: block;
    }
  }
</style>
