---
/**
 * «Купить билет» (Figma: кадр «2»). Билет поворачивается за курсором (эффект Holographic Card,
 * scripts/effects/holo-ticket.ts). Форма с вырезами и линией отрыва — маска из макета (ticket-shape.svg).
 * Снег идёт только в этом блоке, позади билета, и растворяется к началу «Партнёров» (маска на canvas).
 *
 * Поверхность — тёмно-синяя карточка, цвет собран из мягких круглых пятен (__glow): сверху бирюзовый, за заголовком
 * и за кнопкой ярко-голубой, слева, справа и снизу из краёв выходит тёмно-синий. Пятна чуть плывут навстречу курсору,
 * а за самим курсором идёт круг света (__light) — так и получается перламутровый перелив. Спады с плавными шагами,
 * цвета не смешиваются с белым и серым — поэтому переходы чистые.
 *
 * Поверх цвета — голографическая фольга, как у фольгированной визитки: переливающиеся полосы в цветах бренда
 * (голубой, бирюзовый, тёмно-синий, капля фиолетового и розового) идут навстречу курсору, мятая фактура фольги
 * (media/tickets/foil*.webp) освещена то с одной, то с другой стороны — складки играют при наклоне, на гранях вспыхивают блики.
 * Толщина карты: светлая кромка по краю и торец, который виден снизу (на десктопе при повороте — и сбоку).
 *
 * Текст реагирует на свет: поверх обычного слоя лежит его копия с «напылением» — такой же круг вокруг курсора,
 * от белого к бирюзовому кольцу, поэтому буквы переливаются вместе с поверхностью.
 * Слои собраны сеткой, а не абсолютом: background-clip: text не закрашивает текст потомков с position.
 *
 * Мобильный (Figma: «08 · Купить билет»): билет вертикальный, линия отрыва поперёк. Без скриптов: пятна стоят на месте,
 * свет сверху медленно дышит прозрачностью, снег идёт на CSS (ui/MobileSnow.astro).
 */
import Button from '../ui/Button.astro';
import MobileSnow from '../ui/MobileSnow.astro';
import { event, ticket } from '../../data/content';
import { withBase } from '../../lib/paths';

// обычный текст и его копия-напыление (для скринридеров копия скрыта)
const layers = [false, true];
---

<section class="tickets" id="tickets" data-holo-stage style={`--ticket-shape:url(${withBase('/media/tickets/ticket-shape.svg')});--ticket-shape-m:url(${withBase('/media/tickets/ticket-shape-m.svg')});--foil:url(${withBase('/media/tickets/foil.webp')});--foil-inv:url(${withBase('/media/tickets/foil-inv.webp')});--foil-spark:url(${withBase('/media/tickets/foil-spark.webp')})`}>
  <canvas class="tickets__snow" data-snow data-snow-density="1.5" aria-hidden="true"></canvas>
  <MobileSnow />

  <div class="ticket-wrap" data-reveal>
    <article class="ticket" data-holo>
      <span class="ticket__shadow" aria-hidden="true"></span>
      <span class="ticket__edge" aria-hidden="true"></span>
      <div class="ticket__face">
        <span class="ticket__glow" aria-hidden="true"></span>
        <span class="ticket__holo" aria-hidden="true"></span>
        <span class="ticket__texture" aria-hidden="true"></span>
        <span class="ticket__light" aria-hidden="true"></span>
        <span class="ticket__spark" aria-hidden="true"></span>
        <span class="ticket__gloss" aria-hidden="true"></span>
        <span class="ticket__rim" aria-hidden="true"></span>
        <img class="ticket__mark" src={withBase(ticket.mark)} width="47" height="46" alt="" />
        {
          layers.map((ink) => {
            const Title = ink ? 'div' : 'h2';
            return (
              <div class:list={['ticket__copy', { 'ticket__copy--ink': ink }]} aria-hidden={ink ? 'true' : undefined}>
                <Title class="ticket__title">
                  <span class="ticket__line">{ticket.title[0]}</span>
                  <span class="ticket__line ticket__line--accent">{ticket.title[1]}</span>
                </Title>
                <p class="ticket__text fish">{ticket.text}</p>
                <ul class="ticket__perks fish">
                  {ticket.perks.map((perk) => <li>{perk}</li>)}
                </ul>
              </div>
            );
          })
        }
        <div class="ticket__cta">
          <Button href={event.ticketUrl}>{ticket.cta}</Button>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .tickets {
    position: relative;
    height: 810px;
  }
  /* снег проявляется над билетом и уходит в ноль к заголовку «Партнеры» */
  .tickets__snow {
    position: absolute;
    left: 0;
    top: -40px;
    width: 100%;
    height: calc(100% + 40px);
    max-width: none;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 150px, #000 62%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 150px, #000 62%, transparent 100%);
  }

  /* перспектива в пропорции к карточке из эффекта: там 1000 на ширину 460 */
  .ticket-wrap {
    position: absolute;
    left: var(--grid-x);
    top: 135.9px;
    width: 1124px;
    height: 455px;
    perspective: 2400px;
  }
  .ticket {
    --mx: 50%;
    --my: 50%;
    --shine: 0.4;
    /* 0 — покой, 1 — курсор над блоком: насколько текст реагирует на свет */
    --react: 0.2;
    /* откуда свет на фактуре фольги: 0 — слева, 1 — справа */
    --lx: 0.35;
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    will-change: transform;
  }
  /* торец карточки: тот же контур чуть ниже и позади — снизу видна полоска толщиной около миллиметра,
     при повороте открывается и сбоку. Светлый у лица карты, темнее к низу, как срез ламинированного пластика */
  .ticket__edge {
    position: absolute;
    inset: 0;
    background: linear-gradient(#9fe9ff, #2a7fd8 30%, #062a74 75%, #021645);
    -webkit-mask: var(--ticket-shape) center / 100% 100% no-repeat;
    mask: var(--ticket-shape) center / 100% 100% no-repeat;
    transform: translateY(3px) translateZ(-6px);
  }
  /* тень отдельным слоем: filter на билете пересчитывался бы на каждом кадре фольги */
  .ticket__shadow {
    position: absolute;
    inset: 24px 28px 8px;
    border-radius: 40px;
    box-shadow: 0 24px 70px rgb(0 0 0 / 0.45), 0 0 90px rgb(49 168 243 / 0.14);
    transform: translateZ(-8px);
  }
  .ticket__face {
    position: absolute;
    inset: 0;
    background: #003f97;
    -webkit-mask: var(--ticket-shape) center / 100% 100% no-repeat;
    mask: var(--ticket-shape) center / 100% 100% no-repeat;
  }
  /* пятна цвета; первое в списке лежит сверху. Сдвиг --sx/--sy идёт навстречу курсору */
  .ticket__glow {
    --sx: calc((var(--mx) - 50%) * -0.08);
    --sy: calc((var(--my) - 50%) * -0.08);
    position: absolute;
    inset: 0;
    background-image:
      /* тёмно-синий выходит слева, справа и снизу, сверху его нет */
      radial-gradient(
        ellipse 62% 92% at calc(50% + var(--sx)) calc(20% + var(--sy)),
        rgb(0 28 92 / 0) 50%,
        rgb(0 28 92 / 0.16) 62%,
        rgb(0 26 88 / 0.46) 76%,
        rgb(0 24 82 / 0.76) 90%,
        rgb(0 22 78 / 0.92) 100%
      ),
      /* ярко-голубой за заголовком «Купить билет» */
      radial-gradient(
        circle 400px at calc(29% + var(--sx) * 1.6) calc(44% + var(--sy) * 1.6),
        rgb(30 176 255 / 0.92) 0%,
        rgb(30 176 255 / 0.78) 20%,
        rgb(30 176 255 / 0.5) 40%,
        rgb(30 176 255 / 0.23) 60%,
        rgb(30 176 255 / 0.06) 80%,
        rgb(30 176 255 / 0) 100%
      ),
      /* и за кнопкой */
      radial-gradient(
        circle 230px at calc(78.8% - var(--sx)) calc(79% - var(--sy)),
        rgb(30 176 255 / 0.62) 0%,
        rgb(30 176 255 / 0.48) 25%,
        rgb(30 176 255 / 0.22) 55%,
        rgb(30 176 255 / 0.05) 82%,
        rgb(30 176 255 / 0) 100%
      ),
      /* бирюзовый сверху */
      radial-gradient(
        circle 640px at calc(55% - var(--sx) * 1.4) calc(-16% - var(--sy) * 1.4),
        rgb(38 236 214 / 1) 0%,
        rgb(38 236 214 / 0.86) 20%,
        rgb(38 236 214 / 0.56) 40%,
        rgb(38 236 214 / 0.26) 60%,
        rgb(38 236 214 / 0.07) 80%,
        rgb(38 236 214 / 0) 100%
      );
  }
  /* круг света за курсором: screen только осветляет цвет под собой, поэтому не пачкает его */
  .ticket__light {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle 360px at var(--mx) var(--my),
      rgb(110 240 255 / 0.62) 0%,
      rgb(90 226 255 / 0.48) 20%,
      rgb(70 208 255 / 0.27) 42%,
      rgb(50 190 255 / 0.1) 68%,
      rgb(50 190 255 / 0) 100%
    );
    mix-blend-mode: screen;
    opacity: var(--shine);
  }
  /* голографические полосы: мягкие, широкие, в цветах бренда с каплей фиолетового и розового; едут навстречу курсору */
  .ticket__holo {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      118deg,
      rgb(30 176 255 / 0) 0%,
      rgb(38 236 214 / 0.5) 13%,
      rgb(30 176 255 / 0.42) 24%,
      rgb(122 112 255 / 0.3) 33%,
      rgb(255 138 214 / 0.2) 39%,
      rgb(38 236 214 / 0.42) 49%,
      rgb(30 176 255 / 0.46) 61%,
      rgb(14 70 151 / 0) 78%,
      rgb(38 236 214 / 0.3) 90%,
      rgb(30 176 255 / 0) 100%
    );
    background-size: 260% 100%;
    background-position: calc(100% - var(--mx)) 50%;
    mix-blend-mode: screen;
    opacity: 0.9;
  }
  /* мятая фольга: рельеф, освещённый сверху-слева и (инвертированный) снизу-справа; что сильнее — решает курсор (--lx) */
  .ticket__texture {
    position: absolute;
    inset: 0;
    mix-blend-mode: overlay;
  }
  .ticket__texture::before,
  .ticket__texture::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--foil) 0 0 / var(--foil-size, 256px) repeat;
  }
  .ticket__texture::before {
    opacity: calc((1 - var(--lx)) * 0.5);
  }
  .ticket__texture::after {
    background-image: var(--foil-inv);
    opacity: calc(var(--lx) * 0.5);
  }
  /* блёстки: блик вокруг света, видный только на гранях фактуры */
  .ticket__spark {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 340px at var(--mx) var(--my), rgb(255 255 255 / 0.9), rgb(210 250 255 / 0.45) 40%, rgb(255 255 255 / 0) 100%);
    -webkit-mask: var(--foil-spark) 0 0 / var(--foil-size, 256px) repeat;
    mask: var(--foil-spark) 0 0 / var(--foil-size, 256px) repeat;
    mix-blend-mode: screen;
    opacity: calc(0.25 + var(--react) * 0.75);
  }
  /* плёнка: мягкий блик идёт навстречу курсору (как отражение на пластике), светлее верхний левый угол и лёгкое зерно */
  .ticket__gloss {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(ellipse 46% 72% at calc(100% - var(--mx)) calc(100% - var(--my)), rgb(255 255 255 / 0.13), rgb(255 255 255 / 0.05) 45%, rgb(255 255 255 / 0) 75%),
      linear-gradient(158deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0) 34%);
    mix-blend-mode: screen;
  }
  /* кромка: край карты ловит свет — тонкая светлая линия по всему контуру, ярче сверху, и мягкое свечение у края */
  .ticket__rim {
    position: absolute;
    inset: 0;
    border-radius: 40px;
    box-shadow:
      inset 0 0 0 1px rgb(200 245 255 / 0.22),
      inset 0 1.5px 0 rgb(255 255 255 / 0.45),
      inset 1px 0 0 rgb(255 255 255 / 0.12),
      inset 0 -1.5px 0 rgb(0 12 48 / 0.35),
      inset 0 0 14px rgb(120 220 255 / 0.22);
  }

  .ticket__mark,
  .ticket__cta {
    position: absolute;
  }
  .ticket__mark {
    left: 77px;
    top: 98px;
    /* знак на голубом: светлый, чуть разгорается на свету */
    filter: brightness(0) invert(1) opacity(calc(0.86 + var(--react) * 0.14));
  }
  /* слой текста: блоки встают в одну ячейку и расставляются отступами */
  .ticket__copy {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template: 100% / 100%;
  }
  .ticket__copy > * {
    grid-area: 1 / 1;
    justify-self: start;
    align-self: start;
  }
  /* напыление: тот же круг, что у света, — буквы переходят от белого к бирюзовому кольцу и обратно */
  .ticket__copy--ink {
    -webkit-text-fill-color: transparent;
    background-image: radial-gradient(
      circle 420px at var(--mx) var(--my),
      #fff 0%,
      #fff 26%,
      #b8fff5 44%,
      #8decff 60%,
      rgb(141 236 255 / 0.4) 76%,
      rgb(141 236 255 / 0) 92%
    );
    -webkit-background-clip: text;
    background-clip: text;
    opacity: var(--react);
  }
  .ticket__copy--ink li {
    position: static;
  }
  .ticket__copy--ink li::before {
    display: none;
  }
  .ticket__title {
    margin: 87px 0 0 197px;
    font-size: 65px;
    font-weight: 300;
    line-height: 74px;
    letter-spacing: -3.25px;
    color: #fff;
  }
  .ticket__line {
    display: block;
    white-space: nowrap;
  }
  .ticket__line--accent {
    margin-left: 67px;
    /* за заголовком ярко-голубое пятно: акцентный голубой на нём потерялся бы, поэтому слово светлее */
    color: #c6f2ff;
  }
  /* мелкий текст на фактуре фольги: лёгкая тень снизу, как у краски на фольге, — буквы не теряются в складках */
  .ticket__text,
  .ticket__perks {
    text-shadow: 0 1px 2px rgb(0 20 70 / 0.4);
  }
  .ticket__copy--ink .ticket__text,
  .ticket__copy--ink .ticket__perks {
    text-shadow: none;
  }
  .ticket__text {
    margin: 274px 0 0 264px;
    width: 237px;
    color: #fff;
    font-size: 18px;
    font-weight: 300;
    line-height: 26px;
  }
  .ticket__perks {
    margin: 70px 0 0 765px;
    display: grid;
    gap: 12px;
    width: 260px;
    color: #fff;
    font-size: 18px;
    line-height: 26px;
  }
  .ticket__perks li {
    position: relative;
  }
  .ticket__perks li::before {
    content: '';
    position: absolute;
    left: -21px;
    top: 11px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #fff;
  }
  /* кнопка MVP в размере макета: 254×65 — та же кнопка, увеличенная в 1.3 раза */
  .ticket__cta {
    left: 758px;
    top: 327.5px;
  }
  .ticket__cta :global(.btn) {
    --btn-h: 65.13px;
    min-width: 254px;
    gap: 17.3px;
    padding: 2.6px 36px 0;
    font-size: 17.59px;
    line-height: 28.59px;
  }
  .ticket__cta :global(.btn__icon) {
    width: 17.59px;
    height: 15.39px;
  }

  @media (max-aspect-ratio: 1/1) {
    .tickets {
      height: 756px;
    }
    .tickets__snow,
    .ticket__copy--ink,
    .ticket__shadow,
    .ticket__edge {
      display: none;
    }
    .ticket__gloss,
    .ticket__holo,
    .ticket__spark {
      --mx: 62%;
      --my: 16%;
    }
    .ticket__texture {
      --lx: 0.35;
    }
    /* на телефоне блёстки неподвижны: смешивание с маской на каждом кадре — лишняя работа */
    .ticket__spark {
      opacity: 0.6;
    }
    .ticket-wrap {
      left: 50%;
      top: 40px;
      width: 343px;
      height: 636px;
      margin-left: -171.5px;
      perspective: none;
    }
    .ticket {
      transform-style: flat;
      will-change: auto;
    }
    .ticket__face {
      -webkit-mask-image: var(--ticket-shape-m);
      mask-image: var(--ticket-shape-m);
    }
    /* линия отрыва поперёк билета */
    .ticket__face::after {
      content: '';
      position: absolute;
      left: 14px;
      right: 14px;
      top: 296px;
      height: 1px;
      background: repeating-linear-gradient(to right, #04101d 0 1px, transparent 1px 5px);
    }
    .ticket__glow {
      background-image:
        radial-gradient(250px 560px at 172px 120px, rgb(0 24 82 / 0) 50%, rgb(0 24 82 / 0.16) 62%, rgb(0 24 82 / 0.46) 76%, rgb(0 24 82 / 0.76) 90%, rgb(0 24 82 / 0.92) 100%),
        radial-gradient(230px 230px at 130px 130px, rgb(30 176 255 / 0.9) 0%, rgb(30 176 255 / 0.774) 20%, rgb(30 176 255 / 0.495) 40%, rgb(30 176 255 / 0.225) 60%, rgb(30 176 255 / 0.063) 80%, rgb(30 176 255 / 0.0) 100%),
        radial-gradient(160px 160px at 171px 566px, rgb(30 176 255 / 0.62) 0%, rgb(30 176 255 / 0.533) 20%, rgb(30 176 255 / 0.341) 40%, rgb(30 176 255 / 0.155) 60%, rgb(30 176 255 / 0.043) 80%, rgb(30 176 255 / 0.0) 100%),
        radial-gradient(330px 330px at 190px -60px, rgb(38 236 214 / 1) 0%, rgb(38 236 214 / 0.86) 20%, rgb(38 236 214 / 0.55) 40%, rgb(38 236 214 / 0.25) 60%, rgb(38 236 214 / 0.07) 80%, rgb(38 236 214 / 0) 100%);
    }
    /* вместо света за курсором: тот же круг наверху, медленно дышит (только прозрачность) */
    .ticket__light {
      --mx: 62%;
      --my: 16%;
      background-image: radial-gradient(240px 240px at 62% 16%, rgb(110 240 255 / 0.3) 0%, rgb(90 226 255 / 0.22) 24%, rgb(70 208 255 / 0.1) 50%, rgb(50 190 255 / 0) 100%);
      animation: ticket-breathe 7s ease-in-out infinite alternate;
    }
    .ticket__rim {
      border-radius: 32px;
    }
    .ticket__mark {
      left: 24px;
      top: 34px;
      width: 40px;
      height: 39px;
    }
    .ticket__title {
      margin: 28px 0 0 88px;
      font-size: 38px;
      line-height: 44px;
      letter-spacing: -1.9px;
    }
    .ticket__line--accent {
      margin-left: 40px;
    }
    .ticket__text {
      width: 295px;
      margin: 150px 0 0 24px;
      font-size: 16px;
      line-height: 23px;
    }
    .ticket__perks {
      width: 279px;
      margin: 322px 0 0 44px;
      gap: 10px;
      font-size: 16px;
      line-height: 23px;
    }
    .ticket__perks li::before {
      left: -20px;
      top: 9.5px;
    }
    .ticket__cta {
      left: 0;
      right: 0;
      top: 540px;
      display: flex;
      justify-content: center;
    }
    .ticket__cta :global(.btn) {
      --btn-h: 60px;
      min-width: 234px;
      gap: 16px;
      padding: 2.4px 32px 0;
      font-size: 16.2px;
      line-height: 26px;
    }
    .ticket__cta :global(.btn__icon) {
      width: 16.2px;
      height: 14.2px;
    }
  }
  @keyframes ticket-breathe {
    from {
      opacity: 0.35;
    }
    to {
      opacity: 1;
    }
  }
</style>
