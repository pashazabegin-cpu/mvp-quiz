---
/**
 * 07 · Спортивный квиз (Figma: кадр «2» — низ, мобильный — «2 · mobile» → «06», плашка под программой).
 * Тёмная плашка-«сквиркл» на градиенте (белый → синий → почти чёрный). Вокруг плашки по орбите идут иконки:
 * спереди — поверх текста, сзади — за плашкой; размер задаёт перспектива, скролл прокручивает орбиту.
 * Пункты загораются по очереди, текст закрашивается по словам. Логика — scripts/sections/quiz.ts, quiz-orbit.ts
 * Блок не закреплён: высота задана в px макета (1931 на десктопе, 1137 на мобильном) и масштабируется.
 */
import Anno from '../ui/Anno.astro';
import Button from '../ui/Button.astro';
import { event, quiz } from '../../data/content';
import { withBase } from '../../lib/paths';
import { paragraph } from '../../lib/text';

// на орбите 26 мест: каждая иконка дважды, копии — напротив друг друга (одна спереди, другая за плашкой)
const ring = [...quiz.icons, ...quiz.icons];
---

<section class="quiz" id="quiz" data-quiz>
  <div class="quiz__ui" data-quiz-ui>
    <div class="quiz__plate" aria-hidden="true"></div>

    <h2 class="quiz__title" data-split>{quiz.title[0]}<br /><span class="accent">{quiz.title[1]}</span></h2>

    <ol class="quiz__steps">
      {quiz.steps.map((step) => <li class="quiz__step" data-quiz-step>{step}</li>)}
    </ol>

    <div class:list={['quiz__lead', { fish: quiz.draft }]} data-quiz-lead>
      {
        quiz.paragraphs.map((p, i) => (
          <p>
            {paragraph(p, quiz.paragraphsMobile[i]).map((t, j, all) => (
              <>
                {t.word}
                {j < all.length - 1 && ' '}
                {t.d && <br class="br-d" />}
                {t.m && <br class="br-m" />}
              </>
            ))}
          </p>
        ))
      }
    </div>

    <div class="quiz__cta">
      <Button href={event.quizRegisterUrl}>{quiz.cta}</Button>
    </div>

    <div class="orbit" data-orbit aria-hidden="true">
      {
        ring.map((name) => (
          <div class="orbit__item" data-orbit-item>
            <picture>
              <source srcset={withBase(`/media/quiz/${name}.avif`)} type="image/avif" />
              <img src={withBase(`/media/quiz/${name}.png`)} alt="" width="260" height="260" loading="lazy" decoding="async" />
            </picture>
          </div>
        ))
      }
    </div>
  </div>
  <Anno kind="screen">07 · Спортивный квиз</Anno>
</section>

<style>
  /* фон макета (Rectangle 5881): белый до 11.5% → синий #013a8b к 46.7% → #030f1c к 97% */
  .quiz {
    position: relative;
    height: calc(1931px * var(--ui-s));
    overflow: hidden;
    background-color: #fff;
    background-image: linear-gradient(to bottom, rgb(1 58 139 / 0) 11.531%, #013a8b 46.68%, #030f1c 96.998%);
    color: var(--c-text);
  }
  .quiz__ui {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--ui-w);
    height: 1931px;
    transform: scale(var(--ui-s));
    transform-origin: 0 0;
  }
  .quiz__ui > * {
    position: absolute;
  }

  /* плашка 1320×1352 при 1440: поля 60, сквиркл r=260 (n=3) */
  .quiz__plate {
    z-index: 2;
    left: 60px;
    top: 110px;
    width: calc(var(--ui-w) - 120px);
    height: 1352px;
    border-radius: 260px;
    background: #030f1c;
  }
  @supports (corner-shape: squircle) {
    .quiz__plate {
      corner-shape: superellipse(1.585);
    }
  }

  /* текст — над плашкой; передние иконки — ещё выше (z-index ставит quiz-orbit.ts) */
  .quiz__title,
  .quiz__steps,
  .quiz__lead,
  .quiz__cta {
    z-index: 3;
    left: 0;
    width: 100%;
    text-align: center;
  }
  .accent {
    color: var(--c-accent);
  }
  .quiz__title {
    top: 234px;
    font-size: 65px;
    font-weight: 300;
    line-height: 80px;
    letter-spacing: -3.25px;
  }
  .quiz__title :global(.wipe) {
    margin-inline: auto;
  }
  .quiz__steps {
    top: 450px;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
  .quiz__step {
    font-size: 35px;
    font-weight: 300;
    line-height: 45px;
    letter-spacing: -1.75px;
  }
  .quiz__lead {
    top: 842px;
    left: 50%;
    width: 694px;
    margin-left: -347px;
    font-size: 26px;
    line-height: 1.45;
  }
  .quiz__lead p + p {
    margin-top: 1.45em;
  }
  .quiz__cta {
    top: 1298px;
    display: flex;
    justify-content: center;
  }
  .quiz__cta :global(.btn) {
    min-width: 235px;
  }

  /* орбита: слой во весь кадр, у самого слоя нет z-index — иконки встают между плашкой и текстом */
  .orbit {
    inset: 0;
    pointer-events: none;
  }
  .orbit__item {
    position: absolute;
    left: 0;
    top: 0;
    width: 300px;
    height: 300px;
    /* показывает скрипт, когда поставит иконку на орбиту */
    visibility: hidden;
    will-change: transform;
  }
  .orbit__item img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* мобильный («2 · mobile» → «06»): плашка во всю ширину, скругление 74, иконки мельче */
  @media (max-aspect-ratio: 1/1) {
    .quiz {
      height: calc(1137px * var(--ui-s));
    }
    .quiz__ui {
      height: 1137px;
    }
    .quiz__plate {
      left: 0;
      top: 63px;
      width: var(--ui-w);
      height: 954px;
      border-radius: 74px;
    }
    .quiz__title {
      top: 130px;
      font-size: 38px;
      line-height: 36px;
      letter-spacing: -1.9px;
    }
    .quiz__steps {
      top: 251px;
      gap: 4px;
    }
    .quiz__step {
      font-size: 26px;
      line-height: 45px;
      letter-spacing: -1.3px;
    }
    .quiz__lead {
      top: 485px;
      width: 343px;
      margin-left: -171.5px;
      font-size: 18px;
    }
    .quiz__lead p + p {
      margin-top: 26px;
    }
    .quiz__cta {
      top: 888px;
    }
    .orbit__item {
      width: 132px;
      height: 132px;
    }
  }
</style>
