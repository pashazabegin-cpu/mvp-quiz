---
/**
 * Подвал (Figma: кадр «2»): меню по блокам, стеклянный логотип, контакты, соцсети, документы,
 * большой логотип MVP / Квизмас, обрезанный низом страницы. Позади идёт снег (effects/snow.ts).
 * Стеклянный логотип — зацикленное видео (footer.video) нижним слоем, снег идёт поверх него; пока видео не загрузилось — постер.
 * Видео грузится, только когда подвал рядом (scripts/sections/finale.ts).
 * Мобильный (Figma: «12 · Подвал»): картинка по центру, меню столбиком, снег на CSS (ui/MobileSnow.astro).
 */
import MobileSnow from '../ui/MobileSnow.astro';
import { contacts, footer } from '../../data/content';
import { withBase } from '../../lib/paths';

const socials = [
  { icon: '/media/hero/vk.svg', ...contacts.socials.find((s) => s.id === 'vk')! },
  { icon: '/media/hero/telegram.svg', ...contacts.socials.find((s) => s.id === 'tg')! },
];
---

<footer class="footer">
  <div class="footer__media" data-reveal>
    {
      footer.video ? (
        <video data-src={withBase(footer.video)} poster={withBase(footer.image)} width="276" height="283" muted loop playsinline preload="none" aria-hidden="true" />
      ) : (
        <img src={withBase(footer.image)} width="276" height="283" alt="" loading="lazy" decoding="async" />
      )
    }
  </div>
  <canvas class="footer__snow" data-snow data-snow-density="0.9" aria-hidden="true"></canvas>
  <MobileSnow />

  <ul class="footer__nav" data-stagger>
    {
      footer.nav.map((item) => (
        <li>
          <a href={`#${item.id}`}>{item.label}</a>
        </li>
      ))
    }
  </ul>


  <a class="footer__contact" href={contacts.contactUrl} target="_blank" rel="noopener">
    <span>Связаться с нами</span>
    <svg width="13" height="13" viewBox="0 0 14 14" aria-hidden="true">
      <path d="M2 12 12 2M4 2h8v8" fill="none" stroke="#fff" stroke-width="1.1" stroke-linecap="square"></path>
    </svg>
  </a>

  <ul class="footer__socials">
    {
      socials.map((s) => (
        <li>
          <a href={s.url} target="_blank" rel="noopener" aria-label={s.label} data-magnetic>
            <img src={withBase(s.icon)} width="20" height="20" alt="" />
          </a>
        </li>
      ))
    }
  </ul>

  <ul class="footer__docs">
    <li><a href={contacts.policyUrl} target="_blank" rel="noopener">Политика обработки персональных данных</a></li>
    <li><a href={contacts.consentUrl} target="_blank" rel="noopener">Согласие на обработку персональных данных</a></li>
  </ul>

  <img class="footer__logo" src={withBase(footer.logo)} width="1448" height="205" alt="MVP Квизмас" loading="lazy" data-nav-away />
</footer>

<style>
  /* макет: верх подвала — y 11403; логотип тянется на всю ширину и обрезан низом страницы */
  .footer {
    --logo-w: calc(var(--ui-w) + 8px);
    position: relative;
    height: calc(727px + var(--logo-w) * 0.1022);
    overflow: hidden;
    color: #fff;
  }
  .footer__snow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 240px);
    mask-image: linear-gradient(to bottom, transparent 0, #000 240px);
  }
  .footer__nav {
    position: absolute;
    left: calc(50% - 472px);
    top: 100px;
    font-size: 20px;
    font-weight: 300;
    line-height: 40px;
    letter-spacing: -1px;
  }
  .footer__nav a {
    display: inline-block;
    transition: color 0.3s, transform 0.4s var(--ease-out);
  }
  .footer__nav a:hover {
    color: var(--c-accent);
    transform: translateX(6px);
  }
  .footer__media {
    position: absolute;
    left: calc(50% + 258px);
    top: 65px;
    width: 276px;
    height: 280px;
    /* чёрный фон картинки растворяется в тёмном подвале */
    mix-blend-mode: lighten;
  }
  .footer__media img,
  .footer__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .footer__contact {
    position: absolute;
    left: calc(50% - 472px);
    top: 536px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    line-height: 1.2;
  }
  .footer__contact svg {
    flex: none;
    transition: transform 0.4s var(--ease-out);
  }
  .footer__contact:hover svg {
    transform: translate(2px, -2px);
  }
  .footer__socials {
    position: absolute;
    left: calc(50% - 36px);
    top: 529px;
    display: flex;
    gap: 22px;
  }
  .footer__socials a {
    display: block;
    transition: opacity 0.3s;
  }
  .footer__socials a:hover {
    opacity: 0.7;
  }
  .footer__docs {
    position: absolute;
    left: calc(50% + 385px);
    top: 522px;
    display: grid;
    gap: 16.8px;
    width: 168px;
    font-size: 14px;
    line-height: 1.2;
  }
  .footer__docs a {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.5s var(--ease-out);
  }
  .footer__docs a:hover {
    background-size: 100% 1px;
  }
  .footer__logo {
    position: absolute;
    left: 0;
    top: 727px;
    width: var(--logo-w);
    max-width: none;
    height: auto;
    transform: translateX(-8px);
  }

  @media (max-aspect-ratio: 1/1) {
    .footer {
      height: calc(701px + var(--logo-w) * 0.1022);
    }
    .footer__snow {
      display: none;
    }
    .footer__media {
      left: 50%;
      top: 10px;
      width: 198px;
      height: 202px;
      margin-left: -99px;
    }
    .footer__nav {
      left: 16px;
      top: 226px;
      font-size: 18px;
      line-height: 36px;
      letter-spacing: -0.9px;
    }
    .footer__contact {
      left: 16px;
      top: 574px;
    }
    .footer__socials {
      left: auto;
      right: 16px;
      top: 574px;
    }
    .footer__docs {
      left: 16px;
      top: 618px;
      grid-template-columns: repeat(2, 168px);
      gap: 7px;
      width: auto;
    }
    .footer__logo {
      top: 701px;
    }
  }
</style>
