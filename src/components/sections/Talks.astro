---
/**
 * 06 · Программа MVP Talks & Entertainment — белый экран (Figma: кадр «2», низ).
 * Один поток: время — название сессии и спикер — пояснение, между сессиями тонкие линии.
 * Экран закреплён, сессии едут вверх «гармошкой», как в «Как всё пройдёт?».
 * Логика — scripts/sections/talks.ts, scripts/animations/lag-list.ts
 */
import { talks } from '../../data/content';

// короткие слова («в», «и», «на») не оставляем в конце строки — как в макете
const glue = (text: string) => text.replace(/(^|\s)([а-яёa-z]{1,2})\s+/gi, '$1$2 ');
---

<section class="talks stage" id="talks" data-talks data-nav-light>
  <div class="stage__ui talks__ui">
    <div class="talks__list" data-talks-list>
      <header class="talks__head">
        <h2 class="talks__title">
          <span class="talks__line" data-split>{talks.title}</span>
          <span class="talks__line talks__line--accent" data-split>{talks.accent}</span>
        </h2>
        <p class="talks__badge" data-split="dark">{talks.badge}</p>
      </header>
      {
        talks.sessions.map((s) => (
          <article class="talk">
            <span class="time-pill talk__time">{s.time}</span>
            <div class="talk__main">
              <h3 class="talk__title">{glue(s.title)}</h3>
              <p class="talk__speaker">{s.speaker}</p>
            </div>
            <p class="talk__text">{glue(s.text)}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .talks {
    background: #fff;
    color: var(--c-accent-2);
    color-scheme: light;
  }
  /* нижние 300 px макета: сессии проявляются из белого (фон экрана маска не трогает) */
  .talks__ui {
    -webkit-mask-image: linear-gradient(to top, transparent 0, #000 300px);
    mask-image: linear-gradient(to top, transparent 0, #000 300px);
  }
  /* верх заголовка — 189 px от начала белого фона */
  .talks__list {
    left: 0;
    top: calc(50% - 450px + 189px);
    width: 100%;
  }
  .talks__list > * {
    will-change: transform;
  }

  .talks__head {
    position: relative;
    height: 90px;
  }
  .talks__title {
    position: absolute;
    left: calc(60px + var(--col) + 16px);
    top: 0;
    font-size: 45px;
    font-weight: 300;
    line-height: 45px;
    letter-spacing: -2.25px;
    white-space: nowrap;
  }
  .talks__line {
    display: block;
  }
  /* вторая строка начинается с колонки названий сессий (345 при 1440) */
  .talks__line--accent {
    margin-left: calc(var(--col) * 2 - 16px);
    color: var(--c-accent);
  }
  .talks__badge {
    position: absolute;
    left: calc(60px + var(--col) * 8);
    top: 58px;
    color: rgb(14 70 151 / 0.8);
    font-size: 20px;
    font-weight: 300;
    line-height: 20px;
    letter-spacing: 3px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* сессия: время (155) — название и спикер (345) — пояснение (820); линии между сессиями во всю ширину */
  .talk {
    display: grid;
    grid-template-columns: calc(60px + var(--col)) calc(var(--col) * 2) calc(var(--col) * 5) 465px;
    align-items: start;
    padding: 60px 0;
    border-top: 1px solid rgb(124 135 153 / 0.3);
    font-weight: 300;
  }
  .talk:first-of-type {
    margin-top: 100px;
    padding-top: 0;
    border-top: 0;
  }
  .talk__time {
    grid-column: 2;
    margin-top: 7px;
  }
  .talk__main {
    grid-column: 3;
    max-width: 421px;
  }
  .talk__title {
    color: var(--c-accent);
    font-size: 35px;
    font-weight: 300;
    line-height: 45px;
    letter-spacing: -1.75px;
  }
  .talk__speaker {
    margin-top: 15px;
    font-size: 22px;
    line-height: 45px;
    letter-spacing: -1.1px;
  }
  .talk__text {
    grid-column: 4;
    color: #7c8799;
    font-size: 22px;
    line-height: 32px;
  }

  @media (max-aspect-ratio: 4/5) {
    .talks__list {
      top: 56px;
    }
    .talks__head {
      height: auto;
      padding-inline: 16px;
    }
    .talks__title {
      position: static;
      font-size: 34px;
      line-height: 36px;
      letter-spacing: -1.5px;
    }
    .talks__line--accent {
      margin-left: 0;
    }
    .talks__badge {
      position: static;
      margin-top: 16px;
      font-size: 13px;
      letter-spacing: 2px;
    }
    .talk {
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 32px 16px;
    }
    .talk:first-of-type {
      margin-top: 40px;
    }
    .talk__time {
      margin-top: 0;
    }
    .talk__title {
      font-size: 26px;
      line-height: 30px;
      letter-spacing: -1px;
    }
    .talk__speaker {
      margin-top: 8px;
      font-size: 18px;
      line-height: 26px;
      letter-spacing: -0.5px;
    }
    .talk__text {
      font-size: 18px;
      line-height: 26px;
    }
  }
</style>
